{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivendnext.com/extending/contracts/save_rules.v1.schema.json",
  "title": "Save rules, version 1",
  "description": "A Retail Save Rule record, as a System Manager declares it (Desk, the REST API or an import). Checked at save by business_logic/save_rules.py validate_rule; what the schema cannot see (that a field exists on the record type, a workflow is active, a role exists) is checked there too. Page: docs/extending/save_rules.md.",
  "$defs": {
    "declaration": {
      "type": "object",
      "required": [
        "doctype",
        "rule_name",
        "record_type",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "doctype": {
          "const": "Retail Save Rule"
        },
        "rule_name": {
          "description": "The record's name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "record_type": {
          "description": "The record type the rule checks: not a table, a single, a ledger or our own partner records.",
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "child_table": {
          "description": "The table field whose rows the rule checks; left out, the record itself.",
          "type": "string",
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "pattern",
            "length",
            "derived",
            "unique_in_rows",
            "threshold",
            "required_when",
            "locked_in_state",
            "unique_across",
            "role_for_action",
            "count_per_day"
          ]
        },
        "field": {
          "type": "string",
          "maxLength": 80
        },
        "enabled": {
          "description": "1 when left out.",
          "enum": [
            0,
            1
          ]
        },
        "mode": {
          "description": "refuse when left out. A rule on POS Invoice, POS Closing Entry or POS Invoice Merge Log may only flag.",
          "enum": [
            "refuse",
            "flag"
          ]
        },
        "sequence": {
          "type": "integer"
        },
        "message": {
          "description": "The sentence shown instead of the kind's own.",
          "type": "string",
          "maxLength": 140
        },
        "pattern_class": {
          "enum": [
            "alphanumeric",
            "upper_alphanumeric",
            "digits",
            "letters",
            "phone_e164"
          ]
        },
        "pattern": {
          "description": "Anchored with ^ and $, no back-reference or look-around, no repeat inside a repeat, at most two repeats or choices.",
          "type": "string",
          "maxLength": 100,
          "pattern": "^\\^.*[^\\\\]\\$$"
        },
        "min_length": {
          "type": "integer",
          "minimum": 0
        },
        "max_length": {
          "type": "integer",
          "minimum": 0
        },
        "formula": {
          "enum": [
            "scale",
            "days_until",
            "percent",
            "sum_rows",
            "count_rows",
            "days_between"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 80,
          "description": "The first source: the number (scale, sum_rows), the part (percent), the date (days_until) or the earlier date (days_between, where creation may name when the record was made, on a rule without a table)."
        },
        "source_b": {
          "type": "string",
          "maxLength": 80,
          "description": "percent: the whole. days_between: the later date. Either source empty (or a percent's base 0): the figure is cleared."
        },
        "source_table": {
          "type": "string",
          "maxLength": 80,
          "description": "sum_rows and count_rows: the table of the record whose rows are added up or counted. The figure is written on the record's own header."
        },
        "factor": {
          "description": "1 when left out.",
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "operator": {
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ]
        },
        "value": {
          "description": "The limit, a number written as text.",
          "type": "string",
          "maxLength": 40
        },
        "bypass_roles": {
          "description": "Roles that may pass a threshold, or the roles that may take a role_for_action rule's action; one per line.",
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "states": {
          "description": "Workflow states, one per line.",
          "type": "string"
        },
        "locked_fields": {
          "description": "Fields of the record, one per line.",
          "type": "string"
        },
        "action": {
          "description": "role_for_action: the action only its roles may take.",
          "enum": [
            "submit",
            "cancel"
          ]
        },
        "scope_fields": {
          "description": "unique_across: fields of the record, one per line, at most three; the value may repeat where they differ.",
          "type": "string"
        },
        "scope_field": {
          "description": "count_per_day: the one field of the record each value of which has its own count, such as store.",
          "type": "string",
          "maxLength": 80
        },
        "day_field": {
          "description": "count_per_day: a Date or Datetime field; a record counts on its calendar day in the site's time zone (today when it is empty).",
          "type": "string",
          "maxLength": 80
        },
        "cap": {
          "description": "count_per_day: a record that newly meets every condition is refused once this many have been counted for its scope value that day.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "judge_on_change": {
          "description": "threshold: judge the limit only when the record is new, is submitted, or the field's value changed (a table's row when it is new or its value changed). 0 when left out.",
          "enum": [
            0,
            1
          ]
        },
        "value_from_type": {
          "description": "threshold: read the limit from a settings record \u2014 a record type the package installed, or Stock Settings, Selling Settings or Buying Settings (a single). The rule's own value stays required: it is used when the settings value is 0 or the record is missing.",
          "type": "string",
          "maxLength": 140
        },
        "value_from_name": {
          "description": "The settings record's name; a single's name is its record type.",
          "type": "string",
          "maxLength": 140
        },
        "value_field": {
          "description": "The settings record's Int, Float or Percent field holding the limit.",
          "type": "string",
          "maxLength": 80
        },
        "roles_field": {
          "description": "Optional: the settings record's text or Role-link field naming one role that may pass the limit, used instead of bypass_roles (empty: bypass_roles). All, Guest, Desk User and Administrator are ignored.",
          "type": "string",
          "maxLength": 80
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "pattern"
            }
          },
          "required": [
            "field"
          ],
          "oneOf": [
            {
              "required": [
                "pattern_class"
              ]
            },
            {
              "required": [
                "pattern"
              ]
            }
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "length"
            }
          },
          "required": [
            "field"
          ],
          "anyOf": [
            {
              "required": [
                "min_length"
              ],
              "properties": {
                "min_length": {
                  "minimum": 1
                }
              }
            },
            {
              "required": [
                "max_length"
              ],
              "properties": {
                "max_length": {
                  "minimum": 1
                }
              }
            }
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "derived"
            },
            "field": {
              "description": "Never a money field, nor one a total is computed from: no name holding one of these words. A field the shop added is named custom_\u2026 or with an installed package's prefix (checked at save); sum_rows, count_rows and days_between write only a field the shop added.",
              "not": {
                "pattern": "amount|rate|total|price|discount|tax|qty|margin|conversion|paid|outstanding|commission|exchange|incentive|allocated|change|opening"
              }
            }
          },
          "required": [
            "field",
            "formula"
          ],
          "anyOf": [
            {
              "properties": {
                "formula": {
                  "enum": [
                    "scale",
                    "days_until"
                  ]
                }
              },
              "required": [
                "source"
              ]
            },
            {
              "properties": {
                "formula": {
                  "const": "percent"
                }
              },
              "required": [
                "source",
                "source_b"
              ]
            },
            {
              "properties": {
                "formula": {
                  "const": "sum_rows"
                }
              },
              "required": [
                "source_table",
                "source"
              ],
              "not": {
                "required": [
                  "child_table"
                ]
              }
            },
            {
              "properties": {
                "formula": {
                  "const": "count_rows"
                }
              },
              "required": [
                "source_table"
              ],
              "not": {
                "required": [
                  "child_table"
                ]
              }
            },
            {
              "properties": {
                "formula": {
                  "const": "days_between"
                }
              },
              "required": [
                "source",
                "source_b"
              ]
            }
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "unique_in_rows"
            }
          },
          "required": [
            "field",
            "child_table"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "threshold"
            },
            "value": {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          },
          "required": [
            "field",
            "operator",
            "value"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "required_when"
            },
            "conditions": {
              "minItems": 1
            }
          },
          "required": [
            "field",
            "conditions"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "locked_in_state"
            }
          },
          "required": [
            "states",
            "locked_fields"
          ],
          "not": {
            "required": [
              "child_table"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "unique_across"
            }
          },
          "required": [
            "field"
          ],
          "not": {
            "required": [
              "child_table"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "role_for_action"
            },
            "bypass_roles": {
              "minLength": 1
            }
          },
          "required": [
            "action",
            "bypass_roles"
          ],
          "not": {
            "required": [
              "child_table"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "count_per_day"
            }
          },
          "required": [
            "scope_field",
            "day_field",
            "cap"
          ],
          "not": {
            "required": [
              "child_table"
            ]
          }
        }
      ]
    },
    "condition": {
      "type": "object",
      "required": [
        "field",
        "operator"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "A field of the rows the rule checks (of the record, for a rule without a table). On a rule with a table, parent.\u27e8field\u27e9 reads the record's own header field instead (required_when; a count of rows reads its rows only)."
        },
        "operator": {
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<=",
            "is set",
            "is not set",
            "in"
          ],
          "description": "in (count_per_day rules only): the value is one of up to 10 values, separated by commas."
        },
        "value": {
          "type": "string",
          "maxLength": 140
        }
      }
    }
  }
}
