{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ivendnext.com/extending/contracts/payer.v1.schema.json",
 "title": "Payer, version 1",
 "description": "Extension point payer: what iVendNext POS sends a payer service (an insurer, an optical plan, a company paying for its staff) to learn which covers a customer holds (covers_request) and what a picked cover pays, line by line, before the tender (coverage_request), and what the service answers. Money is a whole number of minor units of the sale's currency (currency_exponent digits), never a decimal. Answers are judged whole by business_logic/partner_payer.py validate_covers and validate_coverage: one bad key or value refuses the whole answer, which then reads as no cover. A cover answer is also judged against the ask it answers: every line asked answered exactly once, a line's two shares adding up to its amount_minor, the totals the sums and equal to the sale's total_minor. The service is asked again whenever the basket, the customer or the prescription moves, and at Pay when its answer is older than 10 minutes.",
 "$defs": {
  "settings": {
   "description": "The subscription's settings (a JSON object, stored as text on the Retail Extension Subscription of extension point payer). prescription names the sale details sent as the prescription (each a Sale Attribute; empty = not sent); bill_back_role is the role that may bill a rejected claim back to the customer (Accounts User when empty); clearing_mode is the shop's own Custom mode of payment whose balance sheet account carries the payer's share until it is moved to the payer, required before the service is switched on (a manifest never carries it).",
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "prescription": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "reference": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "prescriber": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "prescriber_licence": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      }
     }
    },
    "bill_back_role": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "clearing_mode": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    }
   }
  },
  "covers_request": {
   "type": "object",
   "required": [
    "point",
    "context"
   ],
   "additionalProperties": false,
   "properties": {
    "point": {
     "const": "payer/1"
    },
    "context": {
     "$ref": "#/$defs/covers_context"
    }
   }
  },
  "covers_context": {
   "description": "Sent when the cashier presses Payer on a sale with a named customer.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "v",
    "point",
    "call",
    "customer",
    "date",
    "store",
    "pos_profile",
    "operator"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "point": {
     "const": "payer"
    },
    "call": {
     "const": "covers"
    },
    "customer": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "store": {
     "type": "string",
     "maxLength": 140
    },
    "pos_profile": {
     "type": "string",
     "maxLength": 140,
     "description": "The till's POS Profile; empty on a sale made in iVendNext Desk."
    },
    "operator": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    }
   }
  },
  "cover": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "member",
    "payer",
    "payer_title",
    "payer_customer",
    "plan",
    "plan_title",
    "member_label",
    "valid_to"
   ],
   "properties": {
    "member": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140,
     "description": "The service's own reference for the customer's cover, sent back on coverage."
    },
    "payer": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "payer_title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "payer_customer": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140,
     "description": "The payer's own Customer record on the shop's site: the party of the journal that books the payer's share. Never the sale's own customer."
    },
    "plan": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "plan_title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "member_label": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140,
     "description": "The member number masked to its last four digits, for the receipt: at most four digits, a digit in any script counting (the product counts Arabic-Indic digits too).",
     "pattern": "^[^0-9]*([0-9][^0-9]*){0,4}$"
    },
    "valid_to": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "price_list": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      }
     ]
    },
    "promotions_apply": {
     "type": "boolean"
    }
   }
  },
  "covers_answer": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "covers",
    "refused"
   ],
   "properties": {
    "covers": {
     "type": "array",
     "maxItems": 10,
     "items": {
      "$ref": "#/$defs/cover"
     }
    },
    "refused": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "code",
        "message"
       ],
       "properties": {
        "code": {
         "type": "string",
         "minLength": 1,
         "maxLength": 140
        },
        "message": {
         "type": "string",
         "minLength": 1,
         "maxLength": 140
        }
       }
      }
     ]
    }
   }
  },
  "coverage_request": {
   "type": "object",
   "required": [
    "point",
    "context"
   ],
   "additionalProperties": false,
   "properties": {
    "point": {
     "const": "payer/1"
    },
    "context": {
     "$ref": "#/$defs/coverage_context"
    }
   }
  },
  "coverage_line": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "line_id",
    "item_code",
    "item_group",
    "gtin",
    "qty",
    "uom",
    "conversion_factor",
    "rate_minor",
    "discount_minor",
    "amount_minor"
   ],
   "properties": {
    "line_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "item_code": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "item_group": {
     "type": "string",
     "maxLength": 140
    },
    "gtin": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      }
     ]
    },
    "qty": {
     "type": "number"
    },
    "uom": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "conversion_factor": {
     "type": "number",
     "minimum": 0
    },
    "rate_minor": {
     "type": "integer"
    },
    "discount_minor": {
     "type": "integer",
     "minimum": 0
    },
    "amount_minor": {
     "type": "integer",
     "description": "The line's total after every discount (the sale's own spread by the tax calculation) plus its share of tax. The lines add up to total_minor exactly."
    }
   }
  },
  "coverage_context": {
   "description": "Sent before the tender, and again whenever the basket, the customer or the prescription moves.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "v",
    "point",
    "call",
    "sale_ref",
    "customer",
    "member",
    "date",
    "currency",
    "currency_exponent",
    "store",
    "pos_profile",
    "operator",
    "price_list",
    "tax_included",
    "prescription",
    "lines",
    "total_minor",
    "rounding_minor"
   ],
   "properties": {
    "v": {
     "const": 1
    },
    "point": {
     "const": "payer"
    },
    "call": {
     "const": "coverage"
    },
    "sale_ref": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140,
     "description": "The till's sale key, the same across a hold and its recall: name the claim from it."
    },
    "customer": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "member": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "currency": {
     "type": "string",
     "minLength": 3,
     "maxLength": 3
    },
    "currency_exponent": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4
    },
    "store": {
     "type": "string",
     "maxLength": 140
    },
    "pos_profile": {
     "type": "string",
     "maxLength": 140
    },
    "operator": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "price_list": {
     "type": "string",
     "maxLength": 140
    },
    "tax_included": {
     "type": "boolean",
     "description": "true: the prices include tax (as the sale's tax rows say), and rate_minor and discount_minor are on that basis."
    },
    "prescription": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "reference": {
         "anyOf": [
          {
           "type": "null"
          },
          {
           "type": "string",
           "minLength": 1,
           "maxLength": 140
          }
         ]
        },
        "prescriber": {
         "anyOf": [
          {
           "type": "null"
          },
          {
           "type": "string",
           "minLength": 1,
           "maxLength": 140
          }
         ]
        },
        "prescriber_licence": {
         "anyOf": [
          {
           "type": "null"
          },
          {
           "type": "string",
           "minLength": 1,
           "maxLength": 140
          }
         ]
        }
       }
      }
     ]
    },
    "lines": {
     "type": "array",
     "minItems": 1,
     "maxItems": 200,
     "items": {
      "$ref": "#/$defs/coverage_line"
     },
     "description": "At most 200: a larger sale is never asked about."
    },
    "total_minor": {
     "type": "integer"
    },
    "rounding_minor": {
     "type": "integer",
     "description": "The sale's rounding adjustment: always the customer's, never a line's."
    }
   }
  },
  "answer_line": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "line_id",
    "sellable"
   ],
   "properties": {
    "line_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 140
    },
    "covered": {
     "type": "boolean"
    },
    "sellable": {
     "type": "boolean"
    },
    "reason": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "enum": [
        "not_on_list",
        "zero_on_list",
        "not_covered",
        "over_limit"
       ]
      }
     ]
    },
    "message": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      }
     ]
    },
    "covered_qty": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "number",
       "minimum": 0
      }
     ]
    },
    "qty_limit": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "number",
       "minimum": 0
      }
     ]
    },
    "payer_share_minor": {
     "type": "integer",
     "minimum": 0
    },
    "patient_share_minor": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "coverage_answer": {
   "oneOf": [
    {
     "description": "cover: every line sellable; the shares are what the sale books.",
     "type": "object",
     "additionalProperties": false,
     "required": [
      "answer",
      "payer",
      "plan",
      "member",
      "claim_ref",
      "no_partial_refund",
      "lines",
      "totals"
     ],
     "properties": {
      "answer": {
       "const": "cover"
      },
      "code": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "message": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "payer": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "plan": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "member": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "claim_ref": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140,
       "description": "The same on every ask for this sale."
      },
      "no_partial_refund": {
       "type": "boolean",
       "description": "true: a return of this sale must take back every line it still holds, in full."
      },
      "lines": {
       "type": "array",
       "maxItems": 200,
       "items": {
        "allOf": [
         {
          "$ref": "#/$defs/answer_line"
         },
         {
          "required": [
           "covered",
           "payer_share_minor",
           "patient_share_minor"
          ]
         }
        ]
       }
      },
      "totals": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "payer_share_minor",
        "patient_share_minor",
        "total_minor"
       ],
       "properties": {
        "payer_share_minor": {
         "type": "integer",
         "minimum": 0
        },
        "patient_share_minor": {
         "type": "integer",
         "minimum": 0
        },
        "total_minor": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     }
    },
    {
     "description": "refuse: a line is not sellable on this cover; the payer leg waits until it goes. Each line with sellable false carries its message (or the answer's).",
     "type": "object",
     "additionalProperties": false,
     "required": [
      "answer",
      "lines"
     ],
     "properties": {
      "answer": {
       "const": "refuse"
      },
      "code": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "message": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "payer": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "plan": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "member": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "claim_ref": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "lines": {
       "type": "array",
       "minItems": 1,
       "maxItems": 200,
       "items": {
        "$ref": "#/$defs/answer_line"
       }
      }
     }
    },
    {
     "description": "no_cover: the customer cannot buy on this cover today.",
     "type": "object",
     "additionalProperties": false,
     "required": [
      "answer",
      "message"
     ],
     "properties": {
      "answer": {
       "const": "no_cover"
      },
      "code": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      },
      "message": {
       "type": "string",
       "minLength": 1,
       "maxLength": 140
      }
     }
    }
   ]
  }
 }
}
