{
  "extension_point": "label_layout",
  "contract": "declaration",
  "about": "A deli pre-pack scale label: the weight, the rate per unit and the pack's total, sized to fit its 50 x 30 mm stock above the 16.4 mm Code-128. On a scale label {price} is the total the barcode charges.",
  "payload": {
    "doctype": "Retail Label Layout",
    "label_name": "LIB1 Deli",
    "width_mm": 50,
    "height_mm": 30,
    "enabled": 1,
    "template": "<div style=\"font:9pt sans-serif;white-space:nowrap;overflow:hidden\">{item_name}</div><div style=\"font:9pt sans-serif\">{weight} {uom} @ {currency} {unit_price}</div><div style=\"font:bold 11pt sans-serif\">{currency} {price}</div>{barcode_svg}"
  }
}
