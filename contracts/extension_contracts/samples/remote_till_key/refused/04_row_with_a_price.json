      "sale_attributes"
    ]
  },
  "payload": {
    "sale_attributes": [
      {
        "sale_attribute": "Loyalty Tier",
        "attribute_value": "Gold",
        "price": 10
      }
    ]
  },
  "expect_refusal": "each row must be exactly {sale_attribute, attribute_value}"
}
