{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivendnext.com/extending/contracts/partner_capture.v1.schema.json",
  "title": "Partner capture, version 1",
  "description": "Extension point capture: what iVendNext POS sends a partner's HTTPS service when an item the service's filter names is scanned (scan_request), when a new customer is added (customer_request) and to check a code the customer gives (verify_request), and what the service answers. Answers are judged by business_logic/partner_capture.py validate_answer and validate_verify: one bad key or value refuses the whole answer, and the declared down answer applies. Page: docs/extending/partner_capture.md.",
  "$defs": {
    "settings": {
      "description": "The subscription's settings field (a JSON object, stored as text on the Retail Extension Subscription of extension point capture): the event, and for a scan its filter. One service answers each event for a POS Profile.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "event"
          ],
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "scan"
            },
            "item_groups": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 140
              }
            },
            "item_field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "anyOf": [
            {
              "required": [
                "item_groups"
              ],
              "properties": {
                "item_groups": {
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "item_field"
              ]
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "event"
          ],
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "customer_add"
            }
          }
        }
      ]
    },
    "scan_request": {
      "type": "object",
      "required": [
        "point",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "point": {
          "const": "capture/1"
        },
        "context": {
          "$ref": "#/$defs/scan_context"
        }
      }
    },
    "scan_context": {
      "description": "No price, total or tender. sale_ref is empty on a sale's first scan; customer is the till's, or null.",
      "type": "object",
      "required": [
        "v",
        "point",
        "event",
        "sale_ref",
        "store",
        "pos_profile",
        "operator",
        "customer",
        "lang",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "point": {
          "const": "capture"
        },
        "event": {
          "const": "scan"
        },
        "sale_ref": {
          "type": "string",
          "maxLength": 80
        },
        "store": {
          "type": "string"
        },
        "pos_profile": {
          "type": "string"
        },
        "operator": {
          "description": "The signed-in cashier's user id. Personal data.",
          "type": "string"
        },
        "customer": {
          "description": "Personal data.",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 140
            },
            {
              "type": "null"
            }
          ]
        },
        "lang": {
          "type": "string"
        },
        "line": {
          "type": "object",
          "required": [
            "item_code",
            "item_group",
            "qty_milli",
            "uom",
            "batch_no",
            "serial_no",
            "scanned_code"
          ],
          "additionalProperties": false,
          "properties": {
            "item_code": {
              "type": "string",
              "minLength": 1
            },
            "item_group": {
              "type": "string"
            },
            "qty_milli": {
              "description": "Quantity in thousandths.",
              "type": "integer",
              "minimum": 1
            },
            "uom": {
              "type": "string"
            },
            "batch_no": {
              "type": "string"
            },
            "serial_no": {
              "type": "string"
            },
            "scanned_code": {
              "type": "string",
              "maxLength": 140
            }
          }
        }
      }
    },
    "customer_request": {
      "type": "object",
      "required": [
        "point",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "point": {
          "const": "capture/1"
        },
        "context": {
          "$ref": "#/$defs/customer_context"
        }
      }
    },
    "customer_context": {
      "description": "Keep challenge_id if you answer challenge: verify sends it back with the code.",
      "type": "object",
      "required": [
        "v",
        "point",
        "event",
        "challenge_id",
        "store",
        "pos_profile",
        "operator",
        "lang",
        "customer"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "point": {
          "const": "capture"
        },
        "event": {
          "const": "customer_add"
        },
        "challenge_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "store": {
          "type": "string"
        },
        "pos_profile": {
          "type": "string"
        },
        "operator": {
          "description": "Personal data.",
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "customer": {
          "type": "object",
          "required": [
            "customer_name",
            "phone",
            "email",
            "customer_group"
          ],
          "additionalProperties": false,
          "properties": {
            "customer_name": {
              "description": "Personal data.",
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            "phone": {
              "description": "Personal data.",
              "type": "string",
              "maxLength": 40
            },
            "email": {
              "description": "Personal data.",
              "type": "string",
              "maxLength": 140
            },
            "customer_group": {
              "type": "string",
              "maxLength": 140
            }
          }
        }
      }
    },
    "verify_request": {
      "type": "object",
      "required": [
        "point",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "point": {
          "const": "capture/1"
        },
        "context": {
          "type": "object",
          "required": [
            "v",
            "point",
            "event",
            "challenge_id",
            "code"
          ],
          "additionalProperties": false,
          "properties": {
            "v": {
              "const": 1
            },
            "point": {
              "const": "capture"
            },
            "event": {
              "const": "verify"
            },
            "challenge_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "code": {
              "description": "What the customer read out: the length you asked for, letters and digits.",
              "type": "string",
              "minLength": 4,
              "maxLength": 8,
              "pattern": "^[A-Za-z0-9]+$"
            }
          }
        }
      }
    },
    "scan_answer": {
      "description": "HTTP 2xx, a JSON object of at most 64 KB.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "verdict"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "allow"
            },
            "line_attributes": {
              "$ref": "#/$defs/line_attributes"
            },
            "sale_attributes": {
              "$ref": "remote_till_key.v1.schema.json#/$defs/sale_attributes"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "question"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "confirm"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "refuse"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            }
          }
        }
      ]
    },
    "customer_answer": {
      "description": "HTTP 2xx, a JSON object of at most 64 KB.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "verdict"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "allow"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "prompt",
            "length"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "challenge"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            },
            "length": {
              "type": "integer",
              "minimum": 4,
              "maximum": 8
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "refuse"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            }
          }
        }
      ]
    },
    "verify_answer": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "verdict"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "ok"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "refuse"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            }
          }
        }
      ]
    },
    "line_attributes": {
      "description": "Values for the scanned line: each name an active Transaction Item Attribute on the site, once; each value plain text that matches the attribute's own pattern when it has one.",
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140,
            "pattern": "^[^<>]*\\S[^<>]*$"
          }
        }
      }
    }
  }
}
