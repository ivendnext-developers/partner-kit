{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivendnext.com/extending/contracts/partner_capture.v1.schema.json",
  "title": "Partner capture, version 1",
  "description": "Extension point capture: what iVendNext POS sends a partner's HTTPS service when an item the service's filter names is scanned (scan_request), when a new customer is added (customer_request), when a cashier puts an existing customer on a sale (select_request), when the quantity of a line the filter names changes (qty_request) and to check a code the customer gives (verify_request), and what the service answers. Answers are judged by business_logic/partner_capture.py validate_answer and validate_verify: one bad key or value refuses the whole answer, and the declared down answer applies. Page: docs/extending/partner_capture.md.",
  "$defs": {
    "settings": {
      "description": "The subscription's settings field (a JSON object, stored as text on the Retail Extension Subscription of extension point capture): the event, and for a scan or a quantity change its filter; for a scan or a customer put on a sale, optionally the partner page its notice points at. One service answers each event for a POS Profile.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "event"
          ],
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "scan"
            },
            "item_groups": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 140
              }
            },
            "item_field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "page": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "description": "The ID (the record name in Desk, not the label) of a Retail Extension Subscription of extension point page placed on the till (Till key, or Till key and Desk page). When the service answers notice, the till's message carries a button that presses that page's key, on the counter and the tablet, after an item is added or a customer is scanned into the sale. Refused at save on customer_add and qty_change, and in a package: the shop sets it after the install."
            }
          },
          "anyOf": [
            {
              "required": [
                "item_groups"
              ],
              "properties": {
                "item_groups": {
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "item_field"
              ]
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "event"
          ],
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "customer_add"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "event"
          ],
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "customer_select"
            },
            "page": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "description": "The ID (the record name in Desk, not the label) of a Retail Extension Subscription of extension point page placed on the till (Till key, or Till key and Desk page). When the service answers notice, the till's message carries a button that presses that page's key, on the counter and the tablet, after an item is added or a customer is scanned into the sale. Refused at save on customer_add and qty_change, and in a package: the shop sets it after the install."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "event"
          ],
          "additionalProperties": false,
          "properties": {
            "event": {
              "const": "qty_change"
            },
            "item_groups": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 140
              }
            },
            "item_field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "anyOf": [
            {
              "required": [
                "item_groups"
              ],
              "properties": {
                "item_groups": {
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "item_field"
              ]
            }
          ]
        }
      ]
    },
    "scan_request": {
      "type": "object",
      "required": [
        "point",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "point": {
          "const": "capture/1"
        },
        "context": {
          "$ref": "#/$defs/scan_context"
        }
      }
    },
    "scan_context": {
      "description": "No price, total or tender. sale_ref is empty on a sale's first scan; customer is the till's, or null.",
      "type": "object",
      "required": [
        "v",
        "point",
        "event",
        "sale_ref",
        "store",
        "pos_profile",
        "operator",
        "customer",
        "lang",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "point": {
          "const": "capture"
        },
        "event": {
          "const": "scan"
        },
        "sale_ref": {
          "type": "string",
          "maxLength": 80
        },
        "store": {
          "type": "string"
        },
        "pos_profile": {
          "type": "string"
        },
        "operator": {
          "description": "The signed-in cashier's user id. Personal data.",
          "type": "string"
        },
        "customer": {
          "description": "Personal data.",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 140
            },
            {
              "type": "null"
            }
          ]
        },
        "lang": {
          "type": "string"
        },
        "line": {
          "type": "object",
          "required": [
            "item_code",
            "item_group",
            "qty_milli",
            "uom",
            "batch_no",
            "serial_no",
            "scanned_code"
          ],
          "additionalProperties": false,
          "properties": {
            "item_code": {
              "type": "string",
              "minLength": 1
            },
            "item_group": {
              "type": "string"
            },
            "qty_milli": {
              "description": "Quantity in thousandths.",
              "type": "integer",
              "minimum": 1
            },
            "uom": {
              "type": "string"
            },
            "batch_no": {
              "type": "string"
            },
            "serial_no": {
              "type": "string"
            },
            "scanned_code": {
              "type": "string",
              "maxLength": 140
            }
          }
        }
      }
    },
    "customer_request": {
      "type": "object",
      "required": [
        "point",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "point": {
          "const": "capture/1"
        },
        "context": {
          "$ref": "#/$defs/customer_context"
        }
      }
    },
    "customer_context": {
      "description": "Keep challenge_id if you answer challenge: verify sends it back with the code.",
      "type": "object",
      "required": [
        "v",
        "point",
        "event",
        "challenge_id",
        "store",
        "pos_profile",
        "operator",
        "lang",
        "customer"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "point": {
          "const": "capture"
        },
        "event": {
          "const": "customer_add"
        },
        "challenge_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "store": {
          "type": "string"
        },
        "pos_profile": {
          "type": "string"
        },
        "operator": {
          "description": "Personal data.",
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "customer": {
          "type": "object",
          "required": [
            "customer_name",
            "phone",
            "email",
            "customer_group"
          ],
          "additionalProperties": false,
          "properties": {
            "customer_name": {
              "description": "Personal data.",
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            "phone": {
              "description": "Personal data.",
              "type": "string",
              "maxLength": 40
            },
            "email": {
              "description": "Personal data.",
              "type": "string",
              "maxLength": 140
            },
            "customer_group": {
              "type": "string",
              "maxLength": 140
            }
          }
        }
      }
    },
    "select_request": {
      "type": "object",
      "required": [
        "point",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "point": {
          "const": "capture/1"
        },
        "context": {
          "$ref": "#/$defs/select_context"
        }
      }
    },
    "select_context": {
      "description": "An existing customer put on a sale (not the store's walk-in, and not a customer this cashier just created). Keep challenge_id if you answer challenge: verify sends it back with the code. The sale cannot be paid until your answer lets the customer on.",
      "type": "object",
      "required": [
        "v",
        "point",
        "event",
        "challenge_id",
        "sale_ref",
        "store",
        "pos_profile",
        "operator",
        "lang",
        "customer"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "point": {
          "const": "capture"
        },
        "event": {
          "const": "customer_select"
        },
        "challenge_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "sale_ref": {
          "description": "The till's own id for the sale; empty before its first line.",
          "type": "string",
          "maxLength": 80
        },
        "store": {
          "type": "string"
        },
        "pos_profile": {
          "type": "string"
        },
        "operator": {
          "description": "Personal data.",
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "customer": {
          "type": "object",
          "required": [
            "customer",
            "customer_name",
            "phone",
            "email",
            "customer_group"
          ],
          "additionalProperties": false,
          "properties": {
            "customer": {
              "description": "The customer's id. Personal data.",
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            "customer_name": {
              "description": "Personal data.",
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            "phone": {
              "description": "Personal data.",
              "type": "string",
              "maxLength": 40
            },
            "email": {
              "description": "Personal data.",
              "type": "string",
              "maxLength": 140
            },
            "customer_group": {
              "type": "string",
              "maxLength": 140
            }
          }
        }
      }
    },
    "qty_request": {
      "type": "object",
      "required": [
        "point",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "point": {
          "const": "capture/1"
        },
        "context": {
          "$ref": "#/$defs/qty_context"
        }
      }
    },
    "qty_context": {
      "description": "No price, total, tender, serial or batch. Sent once a line's quantity has settled (600 ms after the last change); seq rises with each change to the line, and the till drops an answer to an older one. customer is the till's, or null.",
      "type": "object",
      "required": [
        "v",
        "point",
        "event",
        "seq",
        "sale_ref",
        "store",
        "pos_profile",
        "operator",
        "customer",
        "lang",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "point": {
          "const": "capture"
        },
        "event": {
          "const": "qty_change"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "sale_ref": {
          "type": "string",
          "maxLength": 80
        },
        "store": {
          "type": "string"
        },
        "pos_profile": {
          "type": "string"
        },
        "operator": {
          "description": "The signed-in cashier's user id. Personal data.",
          "type": "string"
        },
        "customer": {
          "description": "Personal data.",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 140
            },
            {
              "type": "null"
            }
          ]
        },
        "lang": {
          "type": "string"
        },
        "line": {
          "type": "object",
          "required": [
            "line_ref",
            "item_code",
            "item_group",
            "uom",
            "qty_milli_answered",
            "qty_milli"
          ],
          "additionalProperties": false,
          "properties": {
            "line_ref": {
              "description": "The till's own id for the line, stable while the sale stays on the till's basket.",
              "type": "string",
              "maxLength": 40
            },
            "item_code": {
              "type": "string",
              "minLength": 1
            },
            "item_group": {
              "type": "string"
            },
            "uom": {
              "type": "string"
            },
            "qty_milli_answered": {
              "description": "The quantity last allowed, in thousandths.",
              "type": "integer",
              "minimum": 1
            },
            "qty_milli": {
              "description": "The new quantity, in thousandths.",
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "verify_request": {
      "type": "object",
      "required": [
        "point",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "point": {
          "const": "capture/1"
        },
        "context": {
          "type": "object",
          "required": [
            "v",
            "point",
            "event",
            "challenge_id",
            "code"
          ],
          "additionalProperties": false,
          "properties": {
            "v": {
              "const": 1
            },
            "point": {
              "const": "capture"
            },
            "event": {
              "const": "verify"
            },
            "challenge_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "code": {
              "description": "What the customer read out: the length you asked for, letters and digits.",
              "type": "string",
              "minLength": 4,
              "maxLength": 8,
              "pattern": "^[A-Za-z0-9]+$"
            }
          }
        }
      }
    },
    "scan_answer": {
      "description": "HTTP 2xx, a JSON object of at most 64 KB. notice is allow plus a sentence the till shows, the partner's label first; it may carry the values allow may.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "verdict"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "allow"
            },
            "line_attributes": {
              "$ref": "#/$defs/line_attributes"
            },
            "sale_attributes": {
              "$ref": "remote_till_key.v1.schema.json#/$defs/sale_attributes"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "question"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "confirm"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "refuse"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "notice"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            },
            "line_attributes": {
              "$ref": "#/$defs/line_attributes"
            },
            "sale_attributes": {
              "$ref": "remote_till_key.v1.schema.json#/$defs/sale_attributes"
            }
          }
        }
      ]
    },
    "customer_answer": {
      "description": "HTTP 2xx, a JSON object of at most 64 KB. notice is allow plus a sentence the till shows once the customer is created or on the sale; it carries no values.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "verdict"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "allow"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "prompt",
            "length"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "challenge"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            },
            "length": {
              "type": "integer",
              "minimum": 4,
              "maximum": 8
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "refuse"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "notice"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            }
          }
        }
      ]
    },
    "select_answer": {
      "description": "The same answers as customer_answer: allow (or notice, allow plus a sentence) lets the customer on the sale, refuse takes them off it (the sale goes on without a customer), challenge asks for a code first.",
      "$ref": "#/$defs/customer_answer"
    },
    "qty_answer": {
      "description": "HTTP 2xx, a JSON object of at most 64 KB. allow keeps the new quantity (values may go on the line, never on the sale); confirm asks the cashier; refuse puts the last allowed quantity back. No answer sets a quantity or a price. notice is allow plus a sentence the till shows.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "verdict"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "allow"
            },
            "line_attributes": {
              "$ref": "#/$defs/line_attributes"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "question"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "confirm"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "refuse"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "notice"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            },
            "line_attributes": {
              "$ref": "#/$defs/line_attributes"
            }
          }
        }
      ]
    },
    "verify_answer": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "verdict"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "ok"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verdict",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "refuse"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[^<>]*\\S[^<>]*$"
            }
          }
        }
      ]
    },
    "line_attributes": {
      "description": "Values for the scanned line: each name an active Transaction Item Attribute on the site, once; each value plain text that matches the attribute's own pattern when it has one.",
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140,
            "pattern": "^[^<>]*\\S[^<>]*$"
          }
        }
      }
    }
  }
}
