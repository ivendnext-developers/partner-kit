    {
     "fieldname": "r_dia",
     "fieldtype": "Float",
     "label": "Right diameter (DIA)",
     "precision": "2"
    },
    {
     "fieldname": "cl_col",
     "fieldtype": "Column Break",
     "label": ""
    },
    {
     "fieldname": "l_bc",
     "fieldtype": "Float",
     "label": "Left base curve (BC)",
     "precision": "2"
    },
    {
