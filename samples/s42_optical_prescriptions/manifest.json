{
 "manifest_version": 2,
 "app": "pp_opt",
 "prefix": "PP OPT",
 "title": "Optical prescriptions and lab orders",
 "version": "0.1.0",
 "publisher": "Partner Programme sample",
 "description": "An optical store's prescriptions and lab orders, and a check at the till. A Prescription holds a customer's eye test: Spectacles or Contact lenses, the test date and Valid until, each eye's values, the distances between pupils, a contact lens's fit, notes and a scan. A Lab Order is made from a prescription (its customer and lens values copied, read only) and moves Ordered, Sent to lab, Ready to collect, Collected (or Cancelled) by a workflow; it prints as a job sheet. Each record keeps the customer's e-mail, so the shop's own Notifications can tell the customer when the glasses are ready and when an eye test is due. Item groups and items carry Sold against a prescription: Spectacles, Contact lenses or Not needed (blank: the group above). When the cashier presses Pay, the service refuses a sold line marked Spectacles or Contact lenses when the sale's customer has no prescription of that kind valid until today or later. A refund is never judged. The service reads the customer's prescriptions' kind and Valid until with the app's integration user, never their values, and writes nothing. The install makes the roles PP OPT Optometrist and PP OPT Integration; the shop gives the integration role to the app's user, with a plain read on Item Group and Item. The check installs switched off; when its service is down the sale is paid and flagged for review. allowed_urls is the programme bench's address; a partner writes its own.",
 "allowed_urls": [
  "https://host.docker.internal:8125/opt/check"
 ],
 "doctypes": [
  {
   "name": "PP OPT Settings",
   "autoname": "field:title",
   "track_changes": 1,
   "fields": [
    {
     "fieldname": "title",
     "fieldtype": "Data",
     "label": "Title",
     "reqd": 1,
     "unique": 1,
     "default": "Default",
     "description": "The service reads the record named Default."
    },
    {
     "fieldname": "hours_from_utc",
     "fieldtype": "Float",
     "label": "Hours from UTC at the shop",
     "description": "Your own day decides whether a prescription is still in date: 4 for Dubai, 3 for Nairobi or Riyadh, 2 for Johannesburg, -6 for Mexico City. Blank: UTC. Change it when your clocks change."
    }
   ],
   "permissions": [
    {
     "role": "System Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 0,
     "print": 1,
     "email": 0
    },
    {
     "role": "PP OPT Integration",
     "read": 1,
     "write": 0,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    }
   ]
  },
  {
