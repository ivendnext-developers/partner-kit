     "fieldtype": "Float",
     "label": "Cylinder (CYL)",
     "precision": "2"
    },
    {
     "fieldname": "l_axis",
     "fieldtype": "Int",
     "label": "Axis (0 to 180)"
    },
    {
     "fieldname": "l_col",
     "fieldtype": "Column Break",
     "label": ""
    },
    {
     "fieldname": "l_add",
     "fieldtype": "Float",
     "label": "Addition (ADD)",
     "precision": "2"
    },
    {
     "fieldname": "l_prism",
     "fieldtype": "Float",
     "label": "Prism",
     "precision": "2"
    },
    {
     "fieldname": "l_base",
     "fieldtype": "Select",
     "label": "Base",
     "options": "\nUp\nDown\nIn\nOut"
    },
    {
     "fieldname": "l_va",
