 "custom_fields": [
  {
   "dt": "Item Group",
   "fieldname": "pp_opt_needs",
   "fieldtype": "Select",
   "label": "Sold against a prescription",
   "options": "\nSpectacles\nContact lenses\nNot needed",
   "insert_after": "parent_item_group",
   "description": "Spectacles or Contact lenses: the till sells this group's items only to a customer with a prescription of that kind in date. It covers every group below, unless a group below sets its own (Not needed frees it). Blank: the group above decides."
  },
  {
   "dt": "Item",
   "fieldname": "pp_opt_needs",
   "fieldtype": "Select",
   "label": "Sold against a prescription",
   "options": "\nSpectacles\nContact lenses\nNot needed",
   "insert_after": "stock_uom",
   "description": "This item's own rule, when it differs from its group's. On an item with variants, set it on each variant or on their item group. Blank: its template's, else its item group's."
  }
 ],
 "workflows": [
  {
   "name": "PP OPT Lab Order",
   "document_type": "PP OPT Lab Order",
   "send_email_alert": 0,
   "states": [
    {
     "state": "PP OPT Ordered",
     "allow_edit": "Sales User"
    },
    {
     "state": "PP OPT Sent to lab",
     "allow_edit": "Sales User",
     "update_field": "ready_to_collect",
     "update_value": "0"
    },
    {
     "state": "PP OPT Ready to collect",
     "allow_edit": "Sales User",
     "update_field": "ready_to_collect",
     "update_value": "1"
    },
    {
     "state": "PP OPT Collected",
     "allow_edit": "System Manager",
     "update_field": "closed",
     "update_value": "1"
    },
    {
     "state": "PP OPT Cancelled",
     "allow_edit": "System Manager",
     "update_field": "closed",
     "update_value": "1"
    }
   ],
   "transitions": [
    {
     "state": "PP OPT Ordered",
     "action": "PP OPT Send to lab",
     "next_state": "PP OPT Sent to lab",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "PP OPT Sent to lab",
     "action": "PP OPT Back from lab",
     "next_state": "PP OPT Ready to collect",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "PP OPT Ready to collect",
     "action": "PP OPT Hand over",
     "next_state": "PP OPT Collected",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "PP OPT Ready to collect",
     "action": "PP OPT Send back to lab",
     "next_state": "PP OPT Sent to lab",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "PP OPT Ordered",
     "action": "PP OPT Cancel",
     "next_state": "PP OPT Cancelled",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "PP OPT Sent to lab",
     "action": "PP OPT Cancel",
     "next_state": "PP OPT Cancelled",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "PP OPT Ready to collect",
     "action": "PP OPT Cancel",
     "next_state": "PP OPT Cancelled",
     "allowed": "Sales User",
     "allow_self_approval": 1
    }
   ]
  }
 ],
 "print_formats": [
  {
   "name": "PP OPT Job Sheet",
   "doc_type": "PP OPT Lab Order",
   "print_format_type": "Jinja",
   "html": "<div style=\"font-family: Arial, sans-serif; font-size: 11pt;\">\n<h2 style=\"margin: 0 0 4px;\">Lab job sheet {{ doc.name }}</h2>\n<p style=\"margin: 0 0 10px;\">{{ doc.customer_name or \"\" }} · prescription {{ doc.prescription }} · due {{ doc.get_formatted(\"due_date\") }}</p>\n<table style=\"width: 100%; border-collapse: collapse;\" border=\"1\" cellpadding=\"4\">\n<tr><th></th><th>SPH</th><th>CYL</th><th>Axis</th><th>ADD</th><th>Prism</th><th>Base</th></tr>\n<tr><th>Right</th><td>{{ doc.get_formatted(\"r_sph\") }}</td><td>{{ doc.get_formatted(\"r_cyl\") }}</td><td>{{ doc.r_axis }}</td><td>{{ doc.get_formatted(\"r_add\") }}</td><td>{{ doc.get_formatted(\"r_prism\") }}</td><td>{{ doc.r_base or \"\" }}</td></tr>\n<tr><th>Left</th><td>{{ doc.get_formatted(\"l_sph\") }}</td><td>{{ doc.get_formatted(\"l_cyl\") }}</td><td>{{ doc.l_axis }}</td><td>{{ doc.get_formatted(\"l_add\") }}</td><td>{{ doc.get_formatted(\"l_prism\") }}</td><td>{{ doc.l_base or \"\" }}</td></tr>\n</table>\n<p>Distance PD {{ doc.pd_distance }} mm · near PD {{ doc.pd_near }} mm · fitting heights R {{ doc.r_height }} / L {{ doc.l_height }} mm</p>\n<p>Frame {{ doc.frame or \"\" }} {{ doc.frame_size or \"\" }} · lenses {{ doc.lens or \"\" }} {{ doc.lens_type or \"\" }} · {{ doc.coatings or \"\" }}</p>\n<p>Lab {{ doc.lab or \"\" }} {{ doc.lab_reference or \"\" }} · collect at {{ doc.store or \"\" }}</p>\n<p>{{ doc.notes or \"\" }}</p>\n</div>"
  }
 ],
