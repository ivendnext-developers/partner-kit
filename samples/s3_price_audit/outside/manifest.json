{
 "manifest_version": 2,
 "app": "pp_pdo",
 "prefix": "PP PDO",
 "title": "Price-deviation audit (outside)",
 "version": "0.2.0",
 "publisher": "Partner Programme sample",
 "description": "S3 rebuilt so that the partner's service runs outside the shop, reads booked sales from the event feed with its own user (the role PP PDO Integration, which the install makes), and writes each line sold below list by more than the shop's threshold (PP PDO Settings, record Default; 10 when there is none) into this record type. No partner code runs inside the shop.",
 "allowed_urls": ["https://pdo.partner.example"],
 "doctypes": [
  {"name": "PP PDO Deviation", "autoname": "field:line_key", "track_changes": 1, "title_field": "item_code",
   "sort_field": "posting_date", "sort_order": "DESC",
   "fields": [
    {"fieldname": "line_key", "fieldtype": "Data", "label": "Sale line", "reqd": 1, "unique": 1, "read_only": 1,
     "description": "The sale's line id: one record per line, so a second delivery writes nothing"},
    {"fieldname": "invoice_doctype", "fieldtype": "Select", "label": "Sale type", "options": "POS Invoice\nSales Invoice"},
    {"fieldname": "invoice", "fieldtype": "Dynamic Link", "label": "Sale", "options": "invoice_doctype", "in_list_view": 1},
    {"fieldname": "posting_date", "fieldtype": "Date", "label": "Date", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "pos_profile", "fieldtype": "Link", "label": "Till profile", "options": "POS Profile", "in_standard_filter": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "item_code", "fieldtype": "Link", "label": "Item", "options": "Item", "in_list_view": 1},
    {"fieldname": "qty", "fieldtype": "Float", "label": "Qty"},
    {"fieldname": "price_list_rate", "fieldtype": "Currency", "label": "List price"},
    {"fieldname": "charged_rate", "fieldtype": "Currency", "label": "Charged"},
    {"fieldname": "deviation_percent", "fieldtype": "Percent", "label": "Below list", "in_list_view": 1},
    {"fieldname": "threshold_percent", "fieldtype": "Percent", "label": "Threshold"},
    {"fieldname": "pricing_rules", "fieldtype": "Small Text", "label": "Pricing rules on the line"}
   ],
   "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "share": 1, "print": 1, "email": 1},
                   {"role": "Retail Manager", "read": 1, "write": 0, "create": 0, "delete": 0, "report": 1, "export": 0, "share": 0, "print": 0, "email": 0},
                   {"role": "PP PDO Integration", "read": 1, "write": 0, "create": 1, "delete": 0, "report": 0, "export": 0, "share": 0, "print": 0, "email": 0}]},
  {"name": "PP PDO Settings", "autoname": "field:title", "track_changes": 1,
   "fields": [
    {"fieldname": "title", "fieldtype": "Data", "label": "Title", "reqd": 1, "unique": 1, "default": "Default",
     "description": "Default: the one record the service reads"},
    {"fieldname": "threshold_percent", "fieldtype": "Percent", "label": "Threshold", "reqd": 1, "default": "10",
     "description": "A line charged below its list price by more than this percentage is recorded. A change applies within a minute."}
   ],
   "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 0, "export": 0, "share": 0, "print": 0, "email": 0},
                   {"role": "PP PDO Integration", "read": 1, "write": 0, "create": 0, "delete": 0, "report": 0, "export": 0, "share": 0, "print": 0, "email": 0}]}
 ],
 "reports": [{"name": "PP PDO Deviations This Month", "ref_doctype": "PP PDO Deviation",
              "columns": ["posting_date", "invoice", "item_code", "price_list_rate", "charged_rate", "deviation_percent"],
              "order_by": "deviation_percent desc", "roles": ["System Manager", "Retail Manager"]}],
 "number_cards": [{"name": "PP PDO Deviations", "document_type": "PP PDO Deviation", "function": "Count"}],
 "list_settings": [{"doctype": "PP PDO Deviation", "fields": ["invoice", "item_code", "deviation_percent", "posting_date"]}],
 "registered_applications": [{"name": "PP PDO Feed", "description": "the price-deviation service reads booked sales",
                              "events": ["POS Invoice", "Sales Invoice"]}]
}
