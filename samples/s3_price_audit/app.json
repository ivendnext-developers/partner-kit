{
 "app": "price-audit",
 "version": "1.1.0",
 "port": 8080,
 "health": "/health",
 "size": "small",
 "region": "us",
 "shops": true,
 "runs": "function",
 "handler": "samples/s3_price_audit/outside/app.lambda_handler",
 "package": ["tools/app_template/service", "tools/feed_client/feed_client.py", "samples/s3_price_audit/outside"],
 "schedule": {"pass": "rate(1 minute)"},
 "timeout": 120,
 "env": [
  {"name": "IVN_LIBRARY_APP", "required": true},
  {"name": "PDO_PREFIX", "required": true},
  {"name": "PP_STATE", "required": true}
 ]
}
