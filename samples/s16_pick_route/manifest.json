{
 "manifest_version": 2,
 "app": "pp_pck",
 "prefix": "PP PCK",
 "title": "Assign pick route",
 "version": "0.2.0",
 "publisher": "Partner Programme sample",
 "description": "A button on a submitted Sales Order, Assign pick route, that a stock user presses in Desk. The partner's service receives the order's lines, creates a pick task (this app's own record type, listed under the order) over the record API with its own key, and answers: the task opens. Nothing on the order changes. Every right a role has is written out (read, write, create, delete, report, export, share, print, email): a permission row that leaves one out gets it ON. The install makes the role PP PCK Integration (read and create on the pick task); the shop gives it to the app's integration user (recipes/integration_user.md) and chooses that user on the feed PP PCK Pick feed, which a service serving many shops receives on Connect again. The feed records nothing: it installs switched off and stays off. allowed_urls is the programme bench's address; a partner writes its own.",
 "allowed_urls": ["https://host.docker.internal:8125/press/route"],
 "doctypes": [
  {
   "name": "PP PCK Pick Task Line",
   "istable": 1,
   "fields": [
    {"fieldname": "stop", "fieldtype": "Int", "label": "Stop", "in_list_view": 1},
    {"fieldname": "item_code", "fieldtype": "Link", "label": "Item", "options": "Item", "in_list_view": 1},
    {"fieldname": "qty", "fieldtype": "Float", "label": "Quantity", "in_list_view": 1},
    {"fieldname": "warehouse", "fieldtype": "Link", "label": "Warehouse", "options": "Warehouse", "in_list_view": 1}
   ]
  },
  {
   "name": "PP PCK Pick Task",
   "autoname": "format:PCK-{#####}",
   "track_changes": 1,
   "fields": [
    {"fieldname": "sales_order", "fieldtype": "Link", "label": "Sales Order", "options": "Sales Order", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Customer"},
    {"fieldname": "picker", "fieldtype": "Link", "label": "Picker", "options": "User", "reqd": 1, "in_list_view": 1},
    {"fieldname": "priority", "fieldtype": "Select", "label": "Priority", "options": "Normal\nUrgent", "default": "Normal", "in_list_view": 1},
    {"fieldname": "pick_by", "fieldtype": "Date", "label": "Pick by"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Open\nPicked", "default": "Open"},
    {"fieldname": "press_key", "fieldtype": "Data", "label": "Press key", "read_only": 1},
    {"fieldname": "lines", "fieldtype": "Table", "label": "Lines", "options": "PP PCK Pick Task Line"}
   ],
   "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "share": 1, "print": 1, "email": 1},
    {"role": "Stock Manager", "read": 1, "write": 1, "create": 0, "delete": 0, "report": 1, "export": 1, "share": 0, "print": 1, "email": 0},
    {"role": "Stock User", "read": 1, "write": 1, "create": 0, "delete": 0, "report": 1, "export": 0, "share": 0, "print": 1, "email": 0},
    {"role": "PP PCK Integration", "read": 1, "write": 0, "create": 1, "delete": 0, "report": 0, "export": 0, "share": 0, "print": 0, "email": 0}
   ]
  }
 ],
 "registered_applications": [
  {"name": "PP PCK Pick feed", "description": "the pick route service writes pick tasks as this feed's user", "events": ["PP PCK Pick Task"]}
 ],
 "links": [
  {"doctype": "Sales Order", "link_doctype": "PP PCK Pick Task", "link_fieldname": "sales_order", "group": "Picking"}
 ],
 "extension_subscriptions": [
  {"key": "route", "point": "desk_action", "label": "Pick route service", "endpoint_url": "https://host.docker.internal:8125/press/route", "timeout_seconds": 5}
 ],
 "desk_actions": [
  {
   "record_type": "Sales Order",
   "label": "Assign pick route",
   "group": "Warehouse",
   "placement": "both",
   "service": "route",
   "roles": ["Stock User", "Stock Manager"],
   "on_draft": 0,
   "on_submitted": 1,
   "states": ["To Deliver and Bill", "To Deliver"],
   "inputs": [
    {"fieldname": "picker", "label": "Picker", "fieldtype": "Link", "options": "User", "reqd": 1},
    {"fieldname": "priority", "label": "Priority", "fieldtype": "Select", "options": "Normal\nUrgent", "default": "Normal"}
   ],
   "send_fields": "name, customer, set_warehouse, delivery_date, items(item_code, qty, warehouse)",
   "confirm_text": "Send this order's lines to the pick route service?"
  }
 ]
}
