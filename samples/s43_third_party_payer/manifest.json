 "desk_actions": [
  {
   "record_type": "PP ICP Payer",
   "label": "Build claims",
   "placement": "list",
   "service": "claims",
   "roles": [
    "PP ICP Claims Clerk"
   ],
   "on_draft": 1,
   "on_submitted": 0,
   "send_fields": "name",
   "confirm_text": "Make claims from the sales booked on a payer since the last press?"
  },
  {
   "record_type": "PP ICP Payer",
   "label": "Make the claims file",
   "placement": "form",
   "service": "file",
   "roles": [
    "PP ICP Claims Clerk"
   ],
   "on_draft": 1,
   "on_submitted": 0,
   "send_fields": "name",
   "confirm_text": "Put every Ready claim of this payer in a claims file, and mark them sent?"
  },
  {
   "record_type": "PP ICP Remittance",
   "label": "Match",
   "placement": "form",
   "service": "remit",
   "roles": [
    "PP ICP Claims Clerk"
   ],
   "on_draft": 1,
   "on_submitted": 0,
   "send_fields": "name",
   "confirm_text": "Match each line with its claim?"
  },
  {
   "record_type": "PP ICP Claim",
   "label": "Mark ready",
   "placement": "form",
   "service": "ready",
   "roles": [
    "PP ICP Claims Clerk"
   ],
   "on_draft": 1,
   "on_submitted": 0,
   "send_fields": "name",
   "confirm_text": "Mark this claim ready for the next claims file? It is refused while anything its payer needs is missing."
  },
  {
   "record_type": "PP ICP Claim",
   "label": "Settle as it stands",
   "placement": "form",
   "service": "settle",
   "roles": [
    "PP ICP Claims Clerk"
   ],
   "on_draft": 1,
   "on_submitted": 0,
   "send_fields": "name",
   "confirm_text": "Close this short-paid claim as paid? The shortfall stays on the payer's account for your accountant."
  },
  {
   "record_type": "PP ICP Claim",
   "label": "Bill to the customer",
   "placement": "form",
   "service": "billback",
   "roles": [
    "PP ICP Claims Clerk"
   ],
   "on_draft": 1,
   "on_submitted": 0,
   "send_fields": "name",
   "confirm_text": "Bill what the payer did not pay to the customer, on their own sale?"
