    },
    {
     "fieldname": "rows",
     "fieldtype": "Table",
     "label": "Items and groups",
     "options": "PP ICP Formulary Item"
    }
   ],
   "permissions": [
    {
     "role": "System Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 0,
     "print": 1,
     "email": 0
    },
    {
     "role": "PP ICP Claims Clerk",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 0,
     "print": 1,
     "email": 0
    },
    {
     "role": "PP ICP Integration",
     "read": 1,
     "write": 0,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    }
   ]
  },
  {
   "name": "PP ICP Plan",
   "autoname": "field:title",
   "title_field": "title",
   "search_fields": "payer",
   "description": "A payer's plan: its price list, its formulary and its co-pay rules.",
   "fields": [
    {
     "fieldname": "title",
     "fieldtype": "Data",
     "label": "Name",
     "reqd": 1
    },
    {
     "fieldname": "payer",
     "fieldtype": "Link",
     "label": "Payer",
     "options": "PP ICP Payer",
     "reqd": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "active",
     "fieldtype": "Check",
     "label": "Active",
     "default": "1",
     "in_list_view": 1
    },
    {
     "fieldname": "valid_from",
     "fieldtype": "Date",
     "label": "Valid from"
    },
    {
     "fieldname": "valid_to",
     "fieldtype": "Date",
     "label": "Valid to"
    },
    {
     "fieldname": "cb1",
     "fieldtype": "Column Break"
    },
    {
     "fieldname": "price_list",
     "fieldtype": "Link",
     "label": "Price list",
     "options": "Price List",
     "description": "When set, a sale on this plan is priced on it, and an item it does not carry, or carries at zero, cannot be sold on the plan."
    },
    {
     "fieldname": "covers",
     "fieldtype": "Select",
     "label": "Covers",
     "options": "Formulary items\nEvery item",
     "default": "Formulary items"
    },
    {
     "fieldname": "formulary",
     "fieldtype": "Link",
     "label": "Formulary",
     "options": "PP ICP Formulary",
     "depends_on": "eval:doc.covers=='Formulary items'"
    },
    {
     "fieldname": "rules_sec",
     "fieldtype": "Section Break",
     "label": "Co-pay rules"
    },
    {
     "fieldname": "copay_percent",
     "fieldtype": "Percent",
     "label": "Co-pay %",
     "description": "The customer's share of the covered amount inside the limit."
    },
    {
     "fieldname": "invoice_upper_limit",
     "fieldtype": "Currency",
     "label": "Invoice upper limit",
     "description": "0: none. The payer covers at most this much of one sale; the rest is the customer's."
    },
    {
     "fieldname": "max_patient_amount",
     "fieldtype": "Currency",
     "label": "Maximum co-pay",
     "description": "0: none. The co-pay never exceeds it."
    },
    {
     "fieldname": "cb2",
     "fieldtype": "Column Break"
    },
    {
     "fieldname": "discount_order",
     "fieldtype": "Select",
     "label": "The limit is compared with the amount",
     "options": "Before the limit\nAfter the limit",
     "default": "Before the limit",
     "description": "Before the limit: after the sale's discount. After the limit: before it."
    },
    {
     "fieldname": "copay_order",
     "fieldtype": "Select",
     "label": "The co-pay % is taken",
     "options": "Before the discount\nAfter the discount",
     "default": "Before the discount",
     "description": "Before the discount: the payer keeps the whole discount. After it: the customer shares it."
    },
    {
     "fieldname": "no_partial_refund",
     "fieldtype": "Check",
     "label": "Returned whole or not at all"
    },
    {
     "fieldname": "promotions_apply",
     "fieldtype": "Check",
     "label": "The shop's own promotions apply on this plan",
     "default": "1",
     "description": "Off: a sale on this plan takes the plan's price list without the shop's promotions; a coupon or a staff discount the cashier chose still applies, and so can an old-style pricing rule."
    }
   ],
   "permissions": [
    {
     "role": "System Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
