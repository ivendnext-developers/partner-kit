{
 "manifest_version": 2,
 "app": "pp_icp",
 "prefix": "PP ICP",
 "title": "Third-party payer",
 "version": "0.2.0",
 "publisher": "Partner Programme sample",
 "description": "A third party that pays part of a sale: an insurer, a company paying for its staff, an optical plan. Its payers, plans, formularies and members are records; it answers the till's Payer button line by line, makes a claim from each sale booked on a payer, sends claims as a file, follows each to payment, and bills a rejected claim back to the customer. Rebuilt from the co-pay rules of an iVend Retail pharmacy add-on.",
 "allowed_urls": [
  "https://host.docker.internal:8142/icp/payer",
  "https://host.docker.internal:8142/icp/press/claims",
  "https://host.docker.internal:8142/icp/press/file",
  "https://host.docker.internal:8142/icp/press/remit",
  "https://host.docker.internal:8142/icp/press/ready",
  "https://host.docker.internal:8142/icp/press/settle",
  "https://host.docker.internal:8142/icp/press/billback"
 ],
 "doctypes": [
  {
   "name": "PP ICP Payer",
   "autoname": "field:code",
   "title_field": "title",
   "search_fields": "title,kind",
   "description": "A third party that pays part of a sale: an insurer, a company paying for its staff, an optical plan. What it owes is booked against its own Customer record.",
   "fields": [
    {
     "fieldname": "code",
     "fieldtype": "Data",
     "label": "Code",
     "reqd": 1,
     "unique": 1,
     "description": "A short code: it starts each claim's reference."
    },
    {
     "fieldname": "title",
     "fieldtype": "Data",
     "label": "Name",
     "reqd": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "kind",
     "fieldtype": "Select",
     "label": "Kind",
     "options": "Insurer\nCorporate account\nOptical plan\nOther",
     "default": "Insurer",
     "in_list_view": 1
    },
    {
     "fieldname": "customer",
     "fieldtype": "Link",
     "label": "Customer record",
     "options": "Customer",
     "reqd": 1,
     "description": "The payer's own customer record: the payer door books what the payer owes against it."
    },
    {
     "fieldname": "cb1",
     "fieldtype": "Column Break"
    },
    {
     "fieldname": "active",
     "fieldtype": "Check",
     "label": "Active",
     "default": "1",
     "in_list_view": 1
    },
    {
     "fieldname": "valid_from",
     "fieldtype": "Date",
     "label": "Valid from"
    },
    {
     "fieldname": "valid_to",
     "fieldtype": "Date",
     "label": "Valid to"
    },
    {
     "fieldname": "claims_format",
     "fieldtype": "Select",
     "label": "Claims sent as",
     "options": "File",
     "default": "File",
     "description": "The standard version makes a claims file. A payer's own link (NHIF/SHA, NPHIES, eClaimLink, Shafafiya, NHIA) is a partner's app."
    },
    {
     "fieldname": "needs_sec",
     "fieldtype": "Section Break",
     "label": "What a claim needs",
     "description": "A claim missing any of these stays Incomplete and is never put in a file."
    },
    {
     "fieldname": "needs_member_number",
     "fieldtype": "Check",
     "label": "The member number"
    },
    {
     "fieldname": "needs_card_serial",
     "fieldtype": "Check",
     "label": "The card serial number"
    },
    {
     "fieldname": "needs_prescription",
     "fieldtype": "Check",
     "label": "The prescription"
    },
    {
     "fieldname": "cb2",
     "fieldtype": "Column Break"
    },
    {
     "fieldname": "needs_gtin",
     "fieldtype": "Check",
     "label": "Each line's GTIN",
     "description": "Saudi Arabia's NPHIES bills a drug by its GTIN."
    },
    {
     "fieldname": "needs_dose_frequency",
     "fieldtype": "Check",
     "label": "Each line's dose and frequency",
     "description": "Abu Dhabi's Shafafiya asks for both on every line."
    },
    {
     "fieldname": "notes_sec",
     "fieldtype": "Section Break",
     "label": "Notes"
    },
    {
     "fieldname": "notes",
     "fieldtype": "Small Text",
     "label": "Notes"
    }
   ],
   "permissions": [
    {
     "role": "System Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 0,
     "print": 1,
     "email": 0
    },
    {
     "role": "PP ICP Claims Clerk",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 0,
     "print": 1,
     "email": 0
    },
    {
     "role": "PP ICP Integration",
     "read": 1,
     "write": 0,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    }
   ]
  },
  {
   "name": "PP ICP Formulary Item",
   "istable": 1,
   "fields": [
    {
     "fieldname": "item_code",
     "fieldtype": "Link",
     "label": "Item",
     "options": "Item",
     "in_list_view": 1
    },
    {
     "fieldname": "item_group",
     "fieldtype": "Link",
     "label": "Item group",
     "options": "Item Group",
     "in_list_view": 1
    },
    {
     "fieldname": "covered",
     "fieldtype": "Check",
     "label": "Covered",
     "default": "1",
     "in_list_view": 1
    },
    {
     "fieldname": "extra_pay",
     "fieldtype": "Currency",
     "label": "Extra-item pay a unit",
     "in_list_view": 1,
     "description": "The customer always pays this for each stock unit, before the co-pay."
    },
    {
     "fieldname": "max_qty",
     "fieldtype": "Float",
     "label": "Most units on a sale",
     "in_list_view": 1,
     "description": "0: no limit. Units past it are the customer's."
    }
   ],
   "permissions": []
  },
