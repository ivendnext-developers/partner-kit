{
 "app": "expiry-markdown",
 "version": "1.0.0",
 "port": 8080,
 "health": "/health",
 "size": "small",
 "region": "us",
 "shops": true,
 "runs": "function",
 "handler": "samples/s38_expiry_markdown/service/app.lambda_handler",
 "package": ["tools/app_template/service/function.py", "tools/app_template/service/shops.py", "tools/app_template/service/dynamo.py",
             "tools/app_template/service/ed25519.py", "samples/s38_expiry_markdown/markdown.py", "samples/s38_expiry_markdown/service/app.py"],
 "env": [
  {"name": "IVN_LIBRARY_APP", "required": true},
  {"name": "EXM_PREFIX", "required": true}
 ]
}
