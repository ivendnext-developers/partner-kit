{
 "manifest_version": 2,
 "app": "pp_bln",
 "prefix": "PP BLN",
 "title": "Bin locations",
 "version": "0.1.1",
 "publisher": "Partner Programme sample",
 "description": "Where stock sits inside a store: locations (back room, shop floor), aisles, bins and what is in each bin. The shop's own stock and valuation stay in iVendNext; these records only say where.",
 "allowed_urls": [
  "http://host.docker.internal:8123/webhook",
  "https://bins.partner.example/point/where_is_it"
 ],
 "doctypes": [
  {
   "name": "PP BLN Bin Movement",
   "istable": 1,
   "fields": [
    {
     "fieldname": "kind",
     "fieldtype": "Select",
     "label": "Kind",
     "options": "Putaway\nPick out\nPick in\nSale",
     "in_list_view": 1
    },
    {
     "fieldname": "qty",
     "fieldtype": "Float",
     "label": "Qty",
     "in_list_view": 1
    },
    {
     "fieldname": "short",
     "fieldtype": "Float",
     "label": "Short (sold, not in the bin)",
     "in_list_view": 1
    },
    {
     "fieldname": "reference",
     "fieldtype": "Data",
     "label": "Reference (sale, stock entry)",
     "in_list_view": 1
    },
    {
     "fieldname": "at",
     "fieldtype": "Datetime",
     "label": "At",
     "in_list_view": 1
    }
   ],
   "permissions": []
  },
  {
   "name": "PP BLN Location",
   "autoname": "field:location_name",
   "fields": [
    {
     "fieldname": "location_name",
     "fieldtype": "Data",
     "label": "Location",
     "reqd": 1,
     "unique": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "kind",
     "fieldtype": "Select",
     "label": "Kind",
     "options": "Back room\nShop floor",
     "reqd": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "warehouse",
     "fieldtype": "Link",
     "label": "Warehouse (where the stock is booked)",
     "options": "Warehouse",
     "reqd": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "store",
     "fieldtype": "Link",
     "label": "Store it serves (the till's selling warehouse)",
     "options": "Warehouse",
     "reqd": 1
    }
   ],
   "permissions": [
    {
     "role": "System Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 1,
     "print": 1,
     "email": 1
    },
    {
     "role": "PP Integration",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    },
    {
     "role": "Retail Manager",
     "read": 1,
     "write": 0,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    }
   ]
  },
  {
   "name": "PP BLN Aisle",
   "autoname": "field:aisle_name",
   "fields": [
    {
     "fieldname": "aisle_name",
     "fieldtype": "Data",
     "label": "Aisle",
     "reqd": 1,
     "unique": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "location",
     "fieldtype": "Link",
     "label": "Location",
     "options": "PP BLN Location",
     "reqd": 1,
     "in_list_view": 1
    }
   ],
   "permissions": [
    {
     "role": "System Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 1,
     "print": 1,
     "email": 1
    },
    {
     "role": "PP Integration",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    },
    {
     "role": "Retail Manager",
     "read": 1,
     "write": 0,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    }
   ]
  },
  {
   "name": "PP BLN Bin",
   "autoname": "field:bin_code",
   "fields": [
    {
     "fieldname": "bin_code",
     "fieldtype": "Data",
     "label": "Bin",
     "reqd": 1,
     "unique": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "aisle",
     "fieldtype": "Link",
     "label": "Aisle",
     "options": "PP BLN Aisle",
     "reqd": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "location",
     "fieldtype": "Link",
     "label": "Location",
     "options": "PP BLN Location",
     "fetch_from": "aisle.location",
     "read_only": 1
    }
   ],
   "permissions": [
    {
     "role": "System Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 1,
     "print": 1,
     "email": 1
    },
    {
     "role": "PP Integration",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    },
    {
     "role": "Retail Manager",
     "read": 1,
     "write": 0,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 1,
     "email": 0
    }
   ]
  },
  {
   "name": "PP BLN Item In Bin",
   "autoname": "format:{bin}--{item}",
   "fields": [
    {
     "fieldname": "bin",
     "fieldtype": "Link",
     "label": "Bin",
     "options": "PP BLN Bin",
     "reqd": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "location",
     "fieldtype": "Link",
     "label": "Location",
     "options": "PP BLN Location",
     "fetch_from": "bin.location",
     "read_only": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "item",
     "fieldtype": "Link",
     "label": "Item",
     "options": "Item",
     "reqd": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "qty",
     "fieldtype": "Float",
     "label": "Qty in this bin",
     "in_list_view": 1
    },
    {
     "fieldname": "kind",
     "fieldtype": "Data",
     "label": "Back room or shop floor",
     "read_only": 1
    },
    {
     "fieldname": "warehouse",
     "fieldtype": "Link",
     "label": "Warehouse",
     "options": "Warehouse",
     "read_only": 1
    },
    {
     "fieldname": "store",
     "fieldtype": "Link",
     "label": "Store",
     "options": "Warehouse",
     "read_only": 1
    },
    {
     "fieldname": "movements",
     "fieldtype": "Table",
     "label": "Movements",
     "options": "PP BLN Bin Movement"
    }
   ],
   "permissions": [
    {
     "role": "System Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 1,
     "print": 1,
     "email": 1
    },
    {
     "role": "PP Integration",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    },
    {
     "role": "Retail Manager",
     "read": 1,
     "write": 0,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    }
   ]
  }
 ],
 "custom_fields": [
  {
   "dt": "Item",
   "fieldname": "pp_bln_default_bin",
   "fieldtype": "Link",
   "label": "Default bin (bin locations)",
   "options": "PP BLN Bin",
   "insert_after": "stock_uom"
  }
 ],
 "property_setters": [
  {
   "doc_type": "PP BLN Bin",
   "field_name": "bin_code",
   "property": "bold",
   "value": "1",
   "property_type": "Check"
  },
  {
   "doc_type": "Item",
   "field_name": "pp_bln_default_bin",
   "property": "in_standard_filter",
   "value": "1",
   "property_type": "Check"
  }
 ],
 "print_formats": [
  {
   "name": "PP BLN Bin Label",
   "doc_type": "PP BLN Bin",
   "html": "<div class=\"pp-bln-label\"><h2>{{ doc.bin_code }}</h2><p>{{ doc.aisle }} · {{ doc.location }}</p></div>",
   "css": ".pp-bln-label h2 { font-size: 28px; }"
  }
 ],
 "workspaces": [
  {
   "name": "PP BLN Bins",
   "blocks": [
    {
     "type": "header",
     "data": {
      "text": "<span class=\"h4\">Bin locations</span>",
      "col": 12
     }
    },
    {
     "type": "shortcut",
     "data": {
      "shortcut_name": "Locations",
      "col": 3
     }
    },
    {
     "type": "shortcut",
     "data": {
      "shortcut_name": "Bins",
      "col": 3
     }
    },
    {
     "type": "shortcut",
     "data": {
      "shortcut_name": "What is in each bin",
      "col": 3
     }
    }
   ],
   "shortcuts": [
    {
     "type": "DocType",
     "link_to": "PP BLN Location",
     "label": "Locations"
    },
    {
     "type": "DocType",
     "link_to": "PP BLN Bin",
     "label": "Bins"
    },
    {
     "type": "DocType",
     "link_to": "PP BLN Item In Bin",
     "label": "What is in each bin"
    }
   ]
  }
 ],
 "webhooks": [
  {
   "name": "PP BLN Sales Invoice on_submit",
   "doctype": "Sales Invoice",
   "event": "on_submit",
   "url": "http://host.docker.internal:8123/webhook"
  },
  {
   "name": "PP BLN POS Invoice on_submit",
   "doctype": "POS Invoice",
   "event": "on_submit",
   "url": "http://host.docker.internal:8123/webhook"
  }
 ],
 "remote_keys": [
  {
   "key": "where_is_it",
   "label": "Where is it?",
   "partner_name": "Partner Programme sample",
   "endpoint_url": "https://bins.partner.example/point/where_is_it",
   "returns_message": 1,
   "returns_sale_attributes": 0,
   "timeout_seconds": 3
  }
 ]
}
