   "value": "https://developer.ivendnext.com/samples/s22_customer_loyalty/index.html"},
  {"doc_type": "PP LYL Plan", "property": "documentation", "property_type": "Data",
   "value": "https://developer.ivendnext.com/samples/s22_customer_loyalty/index.html"},
