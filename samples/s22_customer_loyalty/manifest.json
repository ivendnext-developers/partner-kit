 ],
 "links": [
  {
   "doctype": "Customer",
   "link_doctype": "PP LYL Member",
   "link_fieldname": "customer",
   "group": "Loyalty"
  },
  {
   "doctype": "Customer",
   "link_doctype": "PP LYL Ledger",
   "link_fieldname": "customer",
   "group": "Loyalty"
  }
 ],
 "reports": [
  {
   "name": "PP LYL Cash Back",
   "ref_doctype": "PP LYL Ledger",
   "columns": [
    "name",
    "customer",
    "entry_type",
    "status",
    "amount",
    "posting_date"
   ],
   "order_by": "posting_date desc",
   "add_total_row": 1,
   "roles": [
    "Sales Manager"
   ]
  },
  {
   "name": "PP LYL Member cash by day",
   "ref_doctype": "PP LYL Balance",
   "columns": [
    "customer",
    "balance_date",
    "opening",
    "change",
    "closing"
   ],
   "order_by": "balance_date asc",
   "roles": [
    "Sales Manager"
   ]
  }
 ],
 "registered_applications": [
  {
   "name": "PP LYL Loyalty",
   "description": "the partner's loyalty service reads these events",
   "events": [
    "Customer",
    "POS Invoice",
    "Purchase Receipt"
   ]
  }
 ],
 "remote_keys": [
  {
   "key": "pp_lyl_member",
   "label": "Member",
   "partner_name": "Partner Programme sample",
   "endpoint_url": "https://loyalty.partner.example/lyl/member",
   "returns_message": 1,
   "returns_sale_attributes": 0,
   "timeout_seconds": 3
  }
 ],
 "role_rights": [
  {"doctype": "Customer", "role": "PP LYL Integration", "rights": ["read", "write"]},
  {"doctype": "Purchase Order", "role": "PP LYL Integration", "rights": ["read"]},
  {"doctype": "Supplier", "role": "PP LYL Integration", "rights": ["read"]}
 ],
 "records": [
  {"doctype": "Customer Group", "name": "PP LYL Bronze", "values": {"customer_group_name": "PP LYL Bronze", "parent_customer_group": "All Customer Groups", "is_group": 0}},
  {"doctype": "Customer Group", "name": "PP LYL Silver", "values": {"customer_group_name": "PP LYL Silver", "parent_customer_group": "All Customer Groups", "is_group": 0}},
  {"doctype": "Customer Group", "name": "PP LYL Gold", "values": {"customer_group_name": "PP LYL Gold", "parent_customer_group": "All Customer Groups", "is_group": 0}},
  {"doctype": "PP LYL Plan", "name": "Bronze", "values": {"plan_name": "Bronze", "rank": 1, "customer_group": "PP LYL Bronze", "spend_threshold": 0, "discount_percent": 0, "cash_back_percent": 2, "active": 1}},
  {"doctype": "PP LYL Plan", "name": "Silver", "values": {"plan_name": "Silver", "rank": 2, "customer_group": "PP LYL Silver", "spend_threshold": 1000, "discount_percent": 3, "cash_back_percent": 2, "active": 1}},
  {"doctype": "PP LYL Plan", "name": "Gold", "values": {"plan_name": "Gold", "rank": 3, "customer_group": "PP LYL Gold", "spend_threshold": 2500, "discount_percent": 5, "cash_back_percent": 2, "active": 1}},
  {"doctype": "PP LYL Settings", "name": "Default", "values": {"title": "Default", "default_plan": "Bronze", "return_days": 14, "tier_window_days": 365, "max_redemption_percent": 50, "earn_on_redemption": 0}}
 ],
 "property_setters": [
