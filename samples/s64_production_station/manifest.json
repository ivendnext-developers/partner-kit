{
 "manifest_version": 2,
 "app": "pp_pst",
 "prefix": "PP PST",
 "title": "Production station",
 "version": "0.1.0",
 "publisher": "Partner Programme sample",
 "description": "A thrift processing room's station screen, opened by a link on the station's own browser (no sign-in): a worker taps their name, a category and a price point, and a tag prints with the price inside its barcode, in this week's colour. The colours turn each week from a date in PP PST Settings (a lead may set a colour for one day); a field on Item, Tag colour, names each category item's colour, so the station finds the item and nobody picks a colour. The barcode is the engine's own label encoder's (get_item_barcode_for_label); before a price is printed the first time, the engine's own reader (resolve_barcode) must read it back as the same item and price, else the tag is refused. Each tag is a PP PST Tag record; Undo last tag takes the last one of the cart back. Cart full posts, as the app's own user, a Material Receipt of the cart's tags into the processing room at no value (Allow Zero Valuation Rate), then a Material Transfer of the same lines to the place chosen; both name the cart (Stock Entry field Production cart), and a cart is posted once. A production report's Work out writes rows by day, station and worker (pieces, hours, pieces per hour) and by colour week (tagged, sold from the retailer's own POS Sale Report, sell-through). Four reports list them. The install makes the roles PP PST Manager and PP PST Integration and the app's own user; from role_rights it gives PP PST Integration read on Item, Warehouse and System Settings (the site's time zone, for today's colour), read, write, create and submit on Stock Entry, select on the stock entry's lookups, and POS Sale Report with its lookups; PP PST Manager select on Warehouse and Item Group. allowed_urls is the programme bench's address; a partner writes their own service's.",
 "allowed_urls": [
  "https://host.docker.internal:8125/pst/link",
  "https://host.docker.internal:8125/pst/work"
 ],
