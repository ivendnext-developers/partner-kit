{
 "app": "till-guard",
 "version": "1.2.0",
 "port": 8080,
 "health": "/health",
 "size": "small",
 "region": "us",
 "shops": true,
 "runs": "function",
 "handler": "samples/s23_till_guard/service/app.lambda_handler",
