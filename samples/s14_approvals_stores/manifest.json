{
 "manifest_version": 2,
 "app": "pp_aps",
 "prefix": "PP APS",
 "title": "Price change approvals across stores",
 "version": "0.3.2",
 "publisher": "Partner Programme sample",
 "description": "A request to change a selling price names its STORE and moves Requested -> Store Approved -> Head Office Approved -> Applied by a native workflow. A store manager sees and approves only their own store's requests (a User Permission on the store, one per person); head office sees all. An outside service applies an approved change through the record API: within the store's limit (a percentage it reads from its own setting), or whatever head office approved.",
 "doctypes": [
  {
   "name": "PP APS Price Change Request",
   "autoname": "hash",
   "track_changes": 1,
   "fields": [
    {
     "fieldname": "item",
     "fieldtype": "Link",
     "label": "Item",
     "options": "Item",
     "reqd": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "price_list",
     "fieldtype": "Link",
     "label": "Price list",
     "options": "Price List",
     "reqd": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "currency",
     "fieldtype": "Link",
     "label": "Currency",
     "options": "Currency",
     "fetch_from": "price_list.currency",
     "read_only": 1
    },
    {
     "fieldname": "store",
     "fieldtype": "Link",
     "label": "Store",
     "options": "POS Profile",
     "reqd": 1,
     "set_only_once": 1,
     "in_list_view": 1,
     "in_standard_filter": 1
    },
    {
     "fieldname": "new_rate",
     "fieldtype": "Currency",
     "label": "New price",
     "options": "currency",
     "reqd": 1,
     "in_list_view": 1,
     "non_negative": 1
    },
    {
     "fieldname": "reason",
     "fieldtype": "Small Text",
     "label": "Reason"
    }
   ],
   "permissions": [
    {
     "role": "System Manager",
     "read": 1,
     "write": 0,
     "create": 0,
     "delete": 0,
     "report": 1,
     "export": 1,
     "share": 0,
     "print": 1,
     "email": 0
    },
    {
     "role": "PP APS Requester",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    },
    {
     "role": "PP APS Store Manager",
     "read": 1,
     "write": 1,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    },
    {
     "role": "PP APS Head Office",
     "read": 1,
     "write": 1,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    },
    {
     "role": "PP APS Applier",
     "read": 1,
     "write": 1,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    }
   ]
  }
 ],
 "naming_rules": [
  {
   "document_type": "PP APS Price Change Request",
   "prefix": "PP-APS-.YYYY.-",
   "prefix_digits": 5
  }
 ],
 "workflows": [
  {
   "name": "PP APS Price Change Approval",
   "document_type": "PP APS Price Change Request",
   "states": [
    {
     "state": "PP APS Requested",
     "allow_edit": "PP APS Requester"
    },
    {
     "state": "PP APS Store Approved",
     "allow_edit": "PP APS Store Manager"
    },
    {
     "state": "PP APS Head Office Approved",
     "allow_edit": "PP APS Head Office"
    },
    {
     "state": "PP APS Rejected",
     "allow_edit": "PP APS Head Office"
    },
    {
     "state": "PP APS Applied",
     "allow_edit": "PP APS Applier"
    }
   ],
   "transitions": [
    {
     "state": "PP APS Requested",
     "action": "PP APS Store Approve",
     "next_state": "PP APS Store Approved",
     "allowed": "PP APS Store Manager",
     "allow_self_approval": 0
    },
    {
     "state": "PP APS Requested",
     "action": "PP APS Head Office Approve",
     "next_state": "PP APS Head Office Approved",
     "allowed": "PP APS Head Office",
     "allow_self_approval": 0
    },
    {
     "state": "PP APS Store Approved",
     "action": "PP APS Head Office Approve",
     "next_state": "PP APS Head Office Approved",
     "allowed": "PP APS Head Office",
     "allow_self_approval": 0
    },
    {
     "state": "PP APS Requested",
     "action": "PP APS Reject",
     "next_state": "PP APS Rejected",
     "allowed": "PP APS Store Manager"
    },
    {
     "state": "PP APS Store Approved",
     "action": "PP APS Reject",
     "next_state": "PP APS Rejected",
     "allowed": "PP APS Store Manager"
    },
    {
     "state": "PP APS Requested",
     "action": "PP APS Head Office Reject",
     "next_state": "PP APS Rejected",
     "allowed": "PP APS Head Office"
    },
    {
     "state": "PP APS Store Approved",
     "action": "PP APS Head Office Reject",
     "next_state": "PP APS Rejected",
     "allowed": "PP APS Head Office"
    },
    {
     "state": "PP APS Head Office Approved",
     "action": "PP APS Head Office Reject",
     "next_state": "PP APS Rejected",
     "allowed": "PP APS Head Office"
    },
    {
     "state": "PP APS Store Approved",
     "action": "PP APS Apply",
     "next_state": "PP APS Applied",
     "allowed": "PP APS Applier"
    },
    {
     "state": "PP APS Head Office Approved",
     "action": "PP APS Apply",
     "next_state": "PP APS Applied",
     "allowed": "PP APS Applier"
    }
   ]
  }
 ],
 "list_settings": [
  {
   "doctype": "PP APS Price Change Request",
   "fields": [
    "item",
    "price_list",
    "store",
    "new_rate"
   ]
  }
 ],
 "property_setters": [
  {
   "doc_type": "PP APS Price Change Request",
   "property": "documentation",
   "property_type": "Data",
   "value": "https://developer.ivendnext.com/samples/s14_approvals_stores/index.html"
  }
 ]
}
