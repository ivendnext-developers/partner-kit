 "reports": [
  {
   "name": "PP RBO Sales by item",
   "ref_doctype": "PP RBO Issue",
   "report_type": "Report Builder",
   "columns": [
    "posting_date",
    "store",
    "lines.sale",
    "lines.item_code",
    "lines.qty",
    "lines.amount",
    "lines.server",
    "lines.day_part"
   ],
   "order_by": "posting_date desc",
   "add_total_row": 1,
   "roles": [
    "Stock Manager",
    "Accounts User",
    "System Manager"
   ]
  },
  {
   "name": "PP RBO Food cost by ingredient",
   "ref_doctype": "PP RBO Food Cost",
   "report_type": "Report Builder",
   "columns": [
    "from_date",
    "to_date",
    "store",
    "lines.item_code",
    "lines.uom",
    "lines.recipe_qty",
    "lines.sold_qty",
    "lines.other_qty",
    "lines.count_qty",
    "lines.actual_qty",
    "lines.theoretical_value",
    "lines.actual_value",
    "lines.variance_value"
   ],
   "order_by": "to_date desc",
   "add_total_row": 1,
   "roles": [
    "Stock Manager",
    "Accounts Manager",
    "System Manager"
   ]
  }
 ],
 "registered_applications": [
  {
   "name": "PP RBO Back office feed",
   "description": "the back office service reads sales, recipes and stock and writes stock issues as this feed's user; leave the feed switched off",
   "events": [
    "PP RBO Settings"
   ]
  }
 ],
 "extension_subscriptions": [
  {
   "key": "issue",
   "point": "desk_action",
   "label": "Issue ingredients service",
   "endpoint_url": "https://host.docker.internal:8145/press/issue",
   "timeout_seconds": 10
  },
  {
   "key": "foodcost",
   "point": "desk_action",
   "label": "Food cost service",
   "endpoint_url": "https://host.docker.internal:8145/press/foodcost",
   "timeout_seconds": 10
  },
  {
   "key": "allergens",
   "point": "desk_action",
   "label": "Allergen check service",
   "endpoint_url": "https://host.docker.internal:8145/press/allergens",
   "timeout_seconds": 10
  }
 ],
 "desk_actions": [
  {
   "record_type": "PP RBO Settings",
   "label": "Issue ingredients",
   "placement": "form",
   "service": "issue",
   "roles": [
    "Stock Manager",
    "Stock User"
   ],
   "on_draft": 1,
   "on_submitted": 0,
   "send_fields": "name, company",
   "confirm_text": "Take the ingredients of this company's new till sales off stock, one stock issue per store and day?"
  },
  {
   "record_type": "PP RBO Food Cost",
   "label": "Work out food cost",
   "placement": "form",
   "service": "foodcost",
   "roles": [
    "Stock Manager",
    "Accounts Manager"
   ],
   "on_draft": 1,
   "on_submitted": 0,
   "send_fields": "name, store, from_date, to_date"
  },
  {
   "record_type": "Item",
   "label": "Check allergens",
   "placement": "both",
   "service": "allergens",
   "roles": [
    "Item Manager"
   ],
   "on_draft": 1,
   "on_submitted": 0,
   "send_fields": "name, item_name"
  }
 ]
}