{
 "manifest_version": 2,
 "app": "pp_rbo",
 "prefix": "PP RBO",
 "title": "Restaurant back office",
 "version": "0.1.0",
 "publisher": "Partner Programme sample",
 "description": "A restaurant's back office. A dish is a plain item that is not stocked, with the shop's own recipe on it (a Bill of Materials). Issue ingredients, a button on the company's settings record for Stock Managers and Stock Users, takes the ingredients of the till sales booked since the settings' start moment off stock: one issue record per store and day, written first and naming its sales so no sale is taken twice, then the shop's own Material Issue of the recipes' parts (a recipe inside a recipe opened, a part that is not stocked and has none skipped and named), from the store or the settings' kitchen store, dated at the day's last sale, or at the press when the stock came in after the sales. A store short of a part books nothing for that day and the issue names every short part; the next press after a delivery or a count books it. A manager may set an issue Left out instead. A press repeated, or one that stopped half way, books nothing twice; a sale made offline is taken up once it posts. The issue's lines feed a report of sales by item, by who rang them and by day part. Work out food cost, on a food cost record for a store and a period, reads the stock ledger and counts: by recipe, sold as it is, other issues, missing at the count, and both costs as a share of sales. Check allergens, on the Item list or an item, writes a check record of each dish that leaves out an allergen of its recipe's ingredients, each variant with none of its template's, and each word not on the shop's list, and opens it; the till shows the Allergens field on the line and the receipt once the shop adds two field rules in POS Studio. Each press sends the record's name and the fields it names, the pressing user and the language. The install makes the role PP RBO Integration; the install gives it to the app's own user, and the shop gives the role read on POS Invoice, POS Profile, Item, BOM, Bin, Stock Ledger Entry, Stock Reconciliation and Warehouse and read, write, create and submit on Stock Entry, and leaves the feed PP RBO Back office feed off. allowed_urls is the programme bench's address; a partner writes its own.",
 "allowed_urls": [
  "https://host.docker.internal:8145/press/issue",
  "https://host.docker.internal:8145/press/foodcost",
  "https://host.docker.internal:8145/press/allergens"
 ],
 "doctypes": [
  {
   "name": "PP RBO Day Part",
   "istable": 1,
   "permissions": [],
   "fields": [
    {
     "fieldname": "day_part",
     "fieldtype": "Data",
     "label": "Day part",
     "reqd": 1,
     "in_list_view": 1,
     "description": "Your name for it: Breakfast, Lunch, Dinner."
    },
    {
     "fieldname": "from_time",
     "fieldtype": "Time",
     "label": "From",
     "reqd": 1,
     "in_list_view": 1
