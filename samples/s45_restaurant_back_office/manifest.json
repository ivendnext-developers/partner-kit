   ]
  },
  {
   "name": "PP RBO Settings",
   "autoname": "field:company",
   "track_changes": 1,
   "fields": [
    {
     "fieldname": "company",
     "fieldtype": "Link",
     "options": "Company",
     "label": "Company",
     "reqd": 1,
     "unique": 1,
     "in_list_view": 1,
     "description": "One settings record per company. Issue ingredients works for this company's tills."
    },
    {
     "fieldname": "start_from",
     "fieldtype": "Datetime",
     "label": "Issue sales booked from",
     "reqd": 1,
     "description": "Sales booked before this moment are never issued. Set it to when you start (and again after a reinstall), so stock already taken off is not taken off again."
    },
    {
     "fieldname": "days_back",
     "fieldtype": "Int",
     "label": "Look back (days)",
     "default": "7",
     "description": "Each press takes up sales of this many days back that no issue names yet (a sale made offline and posted late is caught). Blank: 7."
    },
    {
     "fieldname": "kitchen_store",
     "fieldtype": "Link",
     "options": "Warehouse",
     "label": "Kitchen store",
     "description": "Blank: each store's ingredients come from that store. Set it when one kitchen cooks for several stores or brands."
    },
    {
     "fieldname": "day_parts_section",
     "fieldtype": "Section Break",
     "label": "Day parts"
    },
    {
     "fieldname": "day_parts",
     "fieldtype": "Table",
     "options": "PP RBO Day Part",
     "label": "Day parts",
     "description": "The sales report names the part of the day each sale was rung in."
    },
    {
     "fieldname": "allergens_section",
     "fieldtype": "Section Break",
     "label": "Allergens"
    },
    {
     "fieldname": "allergens",
     "fieldtype": "Small Text",
     "label": "Your allergen list",
     "default": "Celery\nCereals containing gluten\nCrustaceans\nEggs\nFish\nLupin\nMilk\nMolluscs\nMustard\nTree nuts\nPeanuts\nSesame\nSoya\nSulphites",
     "description": "One per line, in the words your menu uses (the EU's 14 to start). Check allergens names any word on an item that is not on this list."
    },
    {
     "fieldname": "run_started",
     "fieldtype": "Data",
     "label": "Press running since (UTC)",
     "read_only": 1,
     "description": "Set while Issue ingredients runs, so two presses never issue the same sales."
    }
   ],
