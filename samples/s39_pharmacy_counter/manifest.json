   "key": "front",
   "point": "check",
   "label": "Pharmacy counter rules (front)",
   "endpoint_url": "https://host.docker.internal:8125/rxc/front",
   "timeout_seconds": 5,
   "down_answer": "allow_and_flag"
  },
  {
   "key": "desk_order",
   "point": "doccheck",
   "label": "Pharmacy counter rules (sales order)",
   "endpoint_url": "https://host.docker.internal:8125/rxc/desk/order",
   "timeout_seconds": 5,
   "down_answer": "refuse",
   "settings": {
    "record_type": "Sales Order",
