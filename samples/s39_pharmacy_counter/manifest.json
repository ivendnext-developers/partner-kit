   "name": "PP RXC Settings",
   "autoname": "field:title",
   "track_changes": 1,
   "fields": [
    {
     "fieldname": "title",
     "fieldtype": "Data",
     "label": "Title",
     "reqd": 1,
     "unique": 1,
     "default": "Default",
     "description": "The service reads the record named Default."
    },
    {
     "fieldname": "hours_from_utc",
     "fieldtype": "Float",
     "label": "Hours from UTC at the shop",
     "description": "The shop's own day decides a prescription's validity and a licence's date: 3 for Nairobi, 4 for Dubai, 1 for Lagos, -6 for Mexico City. Blank: UTC."
    },
    {
     "fieldname": "walk_in_customers",
     "fieldtype": "Small Text",
     "label": "Walk-in customers, one per line",
     "description": "Customers that stand for an unnamed sale. Each POS Profile's own default customer counts as one already. A prescription or a frequency-capped medicine is never sold to them."
    },
    {
     "fieldname": "keep_section",
     "fieldtype": "Section Break",
     "label": "How long to keep a patient's records"
    },
    {
     "fieldname": "keep_years",
     "fieldtype": "Int",
     "label": "Keep a patient's records for (years)",
     "description": "Counted from the patient's newest prescription, dispensing or change to their patient record. The longest period your pharmacy law sets for a prescription or a register, in any market your companies are in: the app's guide lists each market's, under How long to keep prescriptions. Until it is set, nobody is listed for erasure."
    }
   ],
