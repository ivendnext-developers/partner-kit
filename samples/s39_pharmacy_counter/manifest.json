     "fieldname": "max_fills",
     "fieldtype": "Int",
     "label": "Most fills a prescription may authorise",
     "description": "1: dispensed once. 0: as the prescription says."
    },
    {
     "fieldname": "max_occasions",
     "fieldtype": "Int",
     "label": "Most dispensings of one prescription",
     "description": "Occasions, however small each: such as 3 where a regulation counts occasions. 0: no limit beyond the fills."
    },
    {
     "fieldname": "one_drug_per_rx",
     "fieldtype": "Check",
     "label": "One drug per prescription",
     "description": "A prescription naming more than one item is refused for a line of this class."
    },
    {
     "fieldname": "qty_cap",
     "fieldtype": "Float",
     "label": "Most per sale (stock unit)",
     "description": "0: no cap."
    },
    {
     "fieldname": "freq_qty",
     "fieldtype": "Float",
     "label": "Most per patient (stock unit)",
     "description": "With the days below. 0: no cap."
    },
    {
     "fieldname": "freq_days",
     "fieldtype": "Int",
     "label": "… over this many days"
    },
    {
     "fieldname": "patient_section",
     "fieldtype": "Section Break",
     "label": "The patient"
    },
    {
     "fieldname": "needs_id_number",
     "fieldtype": "Check",
     "label": "Needs the customer's national or residence ID"
    },
    {
     "fieldname": "needs_birth_date",
     "fieldtype": "Check",
     "label": "Needs the customer's date of birth"
    },
    {
     "fieldname": "needs_authority",
     "fieldtype": "Check",
     "label": "Needs the customer's authority to possess"
    },
    {
     "fieldname": "needs_consent",
     "fieldtype": "Check",
     "label": "Needs the patient's recorded consent",
     "description": "Refuse the sale until the patient's PP RXC Patient record holds the day they consented to the pharmacy keeping their records."
    },
    {
     "fieldname": "own_sale_without_rx",
     "fieldtype": "Check",
     "label": "Sold in a sale of its own when not on the prescription",
     "description": "For a register that books the sale's prescription number for the whole sale (Kenya's Prescription Book and Poisons Book): with a prescription named on the sale, an item of this schedule that is not on it is refused."
    },
    {
     "fieldname": "returns_section",
     "fieldtype": "Section Break",
     "label": "Returns"
    },
    {
     "fieldname": "returnable",
     "fieldtype": "Check",
     "label": "Can be taken back once dispensed",
     "description": "Off: the till and Desk returns refuse it."
    },
    {
     "fieldname": "return_gives_back",
     "fieldtype": "Check",
     "label": "A return gives the quantity back to its prescription",
     "default": "1"
    },
    {
     "fieldname": "notes",
     "fieldtype": "Small Text",
     "label": "Source (the law and section)"
    }
   ],
   "permissions": [
