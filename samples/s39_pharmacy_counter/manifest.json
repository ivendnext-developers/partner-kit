 "notifications": [
  {
   "name": "PP RXC Pharmacist Licence Due",
   "document_type": "PP RXC Pharmacist",
   "event": "Days Before",
   "date_changed": "valid_until",
   "days_in_advance": 30,
   "channel": "System Notification",
   "subject": "Pharmacist licence of {{ doc.full_name }} ends on {{ doc.valid_until }}",
   "message": "The licence {{ doc.licence_number }} of {{ doc.full_name }} ({{ doc.user }}) is valid until {{ doc.valid_until }}. After that date the till refuses their pharmacist-only sales.",
   "recipients": [
    {
     "receiver_by_role": "PP RXC Pharmacist in Charge"
    }
   ]
  },
  {
   "name": "PP RXC Premises Licence Due",
   "document_type": "PP RXC Premises Licence",
   "event": "Days Before",
   "date_changed": "valid_until",
   "days_in_advance": 60,
   "channel": "System Notification",
   "subject": "Premises licence {{ doc.licence_number }} ends on {{ doc.valid_until }}",
   "message": "The premises licence {{ doc.licence_number }} of {{ doc.store }}, issued by {{ doc.authority }}, is valid until {{ doc.valid_until }}.",
   "recipients": [
    {
     "receiver_by_role": "PP RXC Pharmacist in Charge"
    }
   ]
  }
 ],
