     "fieldname": "needs_prescription",
     "fieldtype": "Check",
     "label": "Needs a prescription",
     "in_list_view": 1
    },
    {
     "fieldname": "pharmacist_only",
     "fieldtype": "Check",
     "label": "Pharmacist only",
     "in_list_view": 1
    },
    {
     "fieldname": "dispensary_only",
     "fieldtype": "Check",
     "label": "Sold at the dispensary only",
     "description": "The front of the shop's check refuses it."
    },
    {
     "fieldname": "needs_directions",
     "fieldtype": "Check",
     "label": "Needs a doctor's name and directions for use"
    },
    {
     "fieldname": "limits_section",
     "fieldtype": "Section Break",
     "label": "Limits"
    },
