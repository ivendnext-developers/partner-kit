{
 "manifest_version": 2,
 "app": "pp_rxc",
 "prefix": "PP RXC",
 "title": "Pharmacy counter rules",
 "version": "0.1.2",
 "publisher": "Partner Programme sample",
 "description": "A pharmacy counter's rules, checked at Pay on the till and when a sales order, delivery or sales invoice is submitted on the Desk. A line whose drug schedule needs a prescription is paid only against a prescription the pharmacist entered on the Desk, for this customer, in date for its class, with quantity and a fill left; the fill is reserved when the check answers, so two tills cannot both take the last one, and it comes back if the sale is never booked and its POS day closes, or its sale or document is cancelled. A pharmacist-only line is paid only by a user on the app's Pharmacist list whose licence is in date; a schedule can need the customer's ID, date of birth or authority to possess, a doctor's name and directions, a quantity cap per sale and per patient over days; dispensed medicine of a non-returnable schedule is refused at a till return and on a Desk return. Two till services: the dispensary's refuses the sale when the service is down; the front's lets it through, flagged, and refuses medicine that must be sold at the dispensary. Prescriptions, pharmacists, schedules, patients (their identity and consent, on a record only the pharmacist roles read) and dispensings are records in the shop; the service reads them with the app's integration user and writes only its Dispensing records. The install makes the roles PP RXC Integration, PP RXC Pharmacist, PP RXC Pharmacist in Charge and PP RXC Records Officer (nobody holds it: the shop gives it for destroying records whose keeping period has ended); every service installs switched off. allowed_urls is the programme bench's address; a partner writes its own.",
 "allowed_urls": [
  "https://host.docker.internal:8125/rxc/dispensary",
  "https://host.docker.internal:8125/rxc/front",
  "https://host.docker.internal:8125/rxc/desk/order",
  "https://host.docker.internal:8125/rxc/desk/delivery",
  "https://host.docker.internal:8125/rxc/desk/invoice"
 ],
 "doctypes": [
  {
   "name": "PP RXC Settings",
   "autoname": "field:title",
   "track_changes": 1,
   "fields": [
    {
     "fieldname": "title",
     "fieldtype": "Data",
     "label": "Title",
     "reqd": 1,
     "unique": 1,
     "default": "Default",
     "description": "The service reads the record named Default."
    },
    {
     "fieldname": "hours_from_utc",
     "fieldtype": "Float",
     "label": "Hours from UTC at the shop",
     "description": "The shop's own day decides a prescription's validity and a licence's date: 3 for Nairobi, 4 for Dubai, 1 for Lagos, -6 for Mexico City. Blank: UTC."
    },
    {
     "fieldname": "walk_in_customers",
     "fieldtype": "Small Text",
     "label": "Walk-in customers, one per line",
     "description": "Customers that stand for an unnamed sale. Each POS Profile's own default customer counts as one already. A prescription or a frequency-capped medicine is never sold to them."
    }
   ],
   "permissions": [
    {
     "role": "System Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 0,
     "print": 1,
     "email": 0
    },
    {
     "role": "PP RXC Integration",
     "read": 1,
     "write": 0,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    }
   ]
  },
