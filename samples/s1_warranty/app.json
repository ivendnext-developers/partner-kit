{
 "app": "warranty-terms",
 "version": "0.3.1",
 "port": 8080,
 "health": "/health",
 "size": "small",
 "region": "us",
 "shops": true,
 "runs": "function",
 "handler": "samples/s1_warranty/service/hosted.lambda_handler",
 "package": [
  "tools/app_template/service/function.py",
  "tools/app_template/service/shops.py",
  "tools/app_template/service/testcall.py",
  "tools/app_template/service/oneshop.py",
  "tools/app_template/service/dynamo.py",
  "tools/app_template/service/ed25519.py",
  "samples/s1_warranty/core.py",
  "samples/s1_warranty/service/hosted.py",
  "samples/s1_warranty/service/tenant.py",
  "samples/s1_warranty/service/register.py"
 ],
 "env": [
  {
   "name": "IVN_LIBRARY_APP",
   "about": "Your app's id in the App library, in lower case with underscores: for the prefix ACME WRC, acme_wrc. Each site that installs your app connects with a key that names this id.",
   "purpose": "Your app's id in the App library, like acme_wrc for the prefix ACME WRC",
   "required": true,
   "together": []
  }
 ],
 "schedule": {
  "pass": "rate(5 minutes)"
 },
 "timeout": 900
}
