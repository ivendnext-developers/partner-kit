{
 "manifest_version": 2,
 "app": "pp_wrc",
 "prefix": "PP WRC",
 "title": "Warranty terms",
 "version": "0.3.4",
 "publisher": "Partner Programme sample",
 "description": "The partner's warranty terms, moved inside your store's iVendNext: an item's own term wins over its item group's. The till key 'Warranty' reads them. Every few minutes the app reads the sales booked since its last look and adds one Comment to each sale with a covered item, giving its warranty.",
 "doctypes": [
  {
   "name": "PP WRC Warranty Term",
   "autoname": "hash",
   "fields": [
    {
     "fieldname": "applies_to",
     "fieldtype": "Select",
     "label": "Applies to",
     "options": "Item\nItem Group",
     "reqd": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "item",
     "fieldtype": "Link",
     "label": "Item",
     "options": "Item",
     "depends_on": "eval:doc.applies_to=='Item'",
     "in_list_view": 1
    },
    {
     "fieldname": "item_group",
     "fieldtype": "Link",
     "label": "Item group",
     "options": "Item Group",
     "depends_on": "eval:doc.applies_to=='Item Group'",
     "in_list_view": 1
    },
    {
     "fieldname": "months",
     "fieldtype": "Int",
     "label": "Months",
     "reqd": 1,
     "non_negative": 1,
     "in_list_view": 1
    }
   ],
   "permissions": [
    {
     "role": "System Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 1,
     "print": 1,
     "email": 1
    },
    {
     "role": "Retail Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    },
    {
     "role": "PP WRC Integration",
     "read": 1,
     "write": 0,
     "create": 0,
     "delete": 0,
     "report": 0,
     "export": 0,
     "share": 0,
     "print": 0,
     "email": 0
    }
   ]
  }
 ],
 "workspaces": [
  {
   "name": "PP WRC Warranty",
   "blocks": [
    {
     "type": "header",
     "data": {
      "text": "<span class=\"h4\">Warranty terms</span>",
      "col": 12
     }
    },
    {
     "type": "shortcut",
     "data": {
      "shortcut_name": "Warranty terms",
      "col": 4
     }
    }
   ],
   "shortcuts": [
    {
     "type": "DocType",
     "link_to": "PP WRC Warranty Term",
     "label": "Warranty terms"
    }
   ]
  }
 ],
 "property_setters": [
  {
   "doc_type": "PP WRC Warranty Term",
   "property": "documentation",
   "property_type": "Data",
   "value": "https://developer.ivendnext.com/samples/s1_warranty/index.html"
  }
 ],
 "allowed_urls": [
  "https://warranty.partner.example/point/warranty"
 ],
 "remote_keys": [
  {
   "key": "warranty",
   "label": "Warranty",
   "partner_name": "Partner Programme sample",
   "endpoint_url": "https://warranty.partner.example/point/warranty",
   "returns_message": 1,
   "returns_sale_attributes": 0,
   "timeout_seconds": 3
  }
 ],
 "registered_applications": [
  {
   "name": "PP WRC Warranty feed",
   "description": "the app reads the terms, the items and the booked sales and writes one Comment on a covered sale as this user",
   "events": [
    "PP WRC Warranty Term"
   ]
  }
 ],
 "role_rights": [
  {"doctype": "Sales Invoice", "role": "PP WRC Integration", "rights": ["read"]},
  {"doctype": "POS Invoice", "role": "PP WRC Integration", "rights": ["read"]},
  {"doctype": "Serial and Batch Bundle", "role": "PP WRC Integration", "rights": ["read"]},
  {"doctype": "Item", "role": "PP WRC Integration", "rights": ["read"]},
  {"doctype": "Comment", "role": "PP WRC Integration", "rights": ["read", "create"]}
 ],
 "translations": [
  {
   "language": "en",
   "words": {
    "PP WRC Warranty Term": "Warranty term",
    "PP WRC Warranty": "Warranty terms",
    "PP WRC Warranty feed": "Warranty feed"
   }
  }
 ]
}
