{
 "manifest_version": 2,
 "app": "acme_zqx",
 "prefix": "ACME ZQX",
 "title": "Alterations and made-to-measure tickets",
 "version": "1.0.0",
 "publisher": "ACME",
 "description": "Alterations and made-to-measure tickets: A fashion store's alteration and made-to-measure tickets, kept in Desk. Each ACME ZQX Ticket holds the kind (Alteration or Made to measure), the customer with its phone and e-mail (the customer's, read only), the store that hands it over, Taken on, Ready by, the next fitting and the tailor; the till sale and the order it was paid on (each optional); the garments and what to do to each; the measurements; fitting notes; who collected it. A workflow moves it Taken, With the tailor, Fitting, Ready to collect, Handed over (or Cancelled): Ready ticks Ready to collect, which the store's own Notification reads to tell the customer, and Hand over or Cancel ticks Closed. It prints as the customer's slip with a garment tag, and the report Tickets Due lists every open ticket by Ready by. A customer's, a sale's and an order's tickets show under each. The charge and any deposit are rung at the till as before: the app moves no money. The app itself calls nothing outside: no service and no outside address.",
 "doctypes": [
  {
   "name": "ACME ZQX Garment",
   "istable": 1,
   "fields": [
    {
     "fieldname": "garment",
     "fieldtype": "Data",
     "label": "Garment",
     "in_list_view": 1,
     "columns": 3,
     "description": "As the customer and the tag will know it: navy suit trousers, size 34."
    },
    {
     "fieldname": "item",
     "fieldtype": "Link",
     "label": "Item",
     "options": "Item",
     "in_list_view": 1,
     "columns": 2,
     "description": "The item, when the garment was sold here. Optional."
    },
    {
     "fieldname": "work",
     "fieldtype": "Small Text",
     "label": "What to do",
     "in_list_view": 1,
     "columns": 4,
     "description": "Such as: shorten the hem 3 cm, take in the waist 2 cm."
    },
    {
     "fieldname": "done",
     "fieldtype": "Check",
     "label": "Done",
     "in_list_view": 1,
     "columns": 1
    }
   ]
  },
  {
   "name": "ACME ZQX Measure",
   "istable": 1,
   "fields": [
    {
     "fieldname": "measure",
     "fieldtype": "Data",
     "label": "Measure",
     "in_list_view": 1,
     "columns": 3,
     "description": "Such as chest, waist, hips, inside leg, sleeve, neck."
    },
    {
     "fieldname": "value",
     "fieldtype": "Float",
     "label": "Value",
     "precision": "1",
     "in_list_view": 1,
     "columns": 2
    },
    {
     "fieldname": "unit",
     "fieldtype": "Select",
     "label": "Unit",
     "options": "cm\nin",
     "default": "cm",
     "in_list_view": 1,
     "columns": 1
    },
    {
     "fieldname": "note",
     "fieldtype": "Data",
     "label": "Note",
     "in_list_view": 1,
     "columns": 4
    }
   ]
  },
  {
   "name": "ACME ZQX Ticket",
   "autoname": "format:ALT-{#####}",
   "track_changes": 1,
   "title_field": "customer_name",
   "search_fields": "customer,customer_name,customer_phone,due_date",
   "sort_field": "due_date",
   "sort_order": "ASC",
   "permissions": [
    {
     "role": "Sales User",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 0,
     "report": 1,
     "export": 0,
     "share": 0,
     "print": 1,
     "email": 0
    },
    {
     "role": "Sales Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 0,
     "print": 1,
     "email": 0
    },
    {
     "role": "System Manager",
     "read": 1,
     "write": 1,
     "create": 1,
     "delete": 1,
     "report": 1,
     "export": 1,
     "share": 0,
     "print": 1,
     "email": 0
    }
   ],
   "fields": [
    {
     "fieldname": "kind",
     "fieldtype": "Select",
     "label": "Kind",
     "options": "Alteration\nMade to measure",
     "default": "Alteration",
     "reqd": 1,
     "in_list_view": 1,
     "in_standard_filter": 1,
     "description": "Alteration: work on a garment the customer brings or buys. Made to measure: a piece made to the customer's measurements."
    },
    {
     "fieldname": "customer",
     "fieldtype": "Link",
     "label": "Customer",
     "options": "Customer",
     "reqd": 1,
     "in_standard_filter": 1
    },
    {
     "fieldname": "customer_name",
     "fieldtype": "Data",
     "label": "Customer name",
     "fetch_from": "customer.customer_name",
     "read_only": 1,
     "in_list_view": 1
    },
    {
     "fieldname": "customer_phone",
     "fieldtype": "Data",
     "label": "Customer's phone",
     "options": "Phone",
     "fetch_from": "customer.custom_phone_no",
     "read_only": 1,
     "description": "The customer's Phone Number, as the till keeps it. Change it on the customer. Your own ready message can be sent to it."
    },
    {
     "fieldname": "customer_email",
     "fieldtype": "Data",
     "label": "Customer's e-mail",
     "options": "Email",
     "fetch_from": "customer.custom_email",
     "read_only": 1,
     "description": "The customer's Email, as the till keeps it. Change it on the customer."
    },
    {
     "fieldname": "col1",
     "fieldtype": "Column Break",
     "label": ""
    },
    {
     "fieldname": "store",
     "fieldtype": "Link",
     "label": "Collect at",
     "options": "Warehouse",
     "reqd": 1,
     "in_list_view": 1,
     "in_standard_filter": 1,
     "description": "The store that keeps the garment and hands it over."
    },
    {
     "fieldname": "store_name",
     "fieldtype": "Data",
     "label": "Store name",
     "fetch_from": "store.warehouse_name",
     "read_only": 1
    },
    {
     "fieldname": "taken_on",
     "fieldtype": "Date",
     "label": "Taken on",
     "default": "Today",
     "reqd": 1
    },
    {
     "fieldname": "due_date",
     "fieldtype": "Date",
     "label": "Ready by",
     "reqd": 1,
     "in_list_view": 1,
     "in_standard_filter": 1,
     "description": "The date promised to the customer."
    },
    {
     "fieldname": "next_fitting",
     "fieldtype": "Datetime",
     "label": "Next fitting",
     "in_list_view": 1
    },
    {
     "fieldname": "tailor",
     "fieldtype": "Data",
     "label": "Tailor or workroom",
     "in_standard_filter": 1
    },
    {
     "fieldname": "paid_section",
     "fieldtype": "Section Break",
     "label": "Paid at the till"
    },
    {
     "fieldname": "sale",
     "fieldtype": "Link",
     "label": "Sale",
     "options": "POS Invoice",
     "description": "The till sale that charged the alteration, or sold the garment. Optional."
    },
    {
     "fieldname": "paid_col",
     "fieldtype": "Column Break",
     "label": ""
    },
    {
     "fieldname": "order",
     "fieldtype": "Link",
     "label": "Order",
     "options": "Sales Order",
     "description": "The order a made-to-measure piece was ordered on, with its deposit. Optional."
    },
    {
     "fieldname": "garments_section",
     "fieldtype": "Section Break",
     "label": "Garments and the work"
    },
    {
     "fieldname": "garments",
     "fieldtype": "Table",
     "label": "Garments",
     "options": "ACME ZQX Garment"
    },
    {
     "fieldname": "measure_section",
     "fieldtype": "Section Break",
     "label": "Measurements and fittings",
     "collapsible": 1
    },
    {
     "fieldname": "measurements",
     "fieldtype": "Table",
     "label": "Measurements",
     "options": "ACME ZQX Measure"
    },
    {
     "fieldname": "fitting_notes",
     "fieldtype": "Small Text",
     "label": "Fitting notes",
     "description": "What changed at each fitting, with its date."
    },
    {
     "fieldname": "handover_section",
     "fieldtype": "Section Break",
     "label": "Hand-over"
    },
    {
     "fieldname": "ready_to_collect",
     "fieldtype": "Check",
     "label": "Ready to collect",
     "read_only": 1,
     "description": "Ticked when the ticket is marked Ready, unticked by Back to tailor. To tell the customer it is ready, add your own Notification on a change of this field that sends only while it is ticked."
    },
    {
     "fieldname": "closed",
     "fieldtype": "Check",
     "label": "Closed",
     "read_only": 1,
     "description": "Ticked by Hand over or Cancel."
    },
    {
     "fieldname": "hand_col",
     "fieldtype": "Column Break",
     "label": ""
    },
    {
     "fieldname": "collected_by",
     "fieldtype": "Data",
     "label": "Collected by",
     "description": "The name of the person who took the garment. Write it before Hand over: Hand over does not ask for it."
    },
    {
     "fieldname": "notes",
     "fieldtype": "Small Text",
     "label": "Notes"
    }
   ]
  }
 ],
 "workflows": [
  {
   "name": "ACME ZQX Ticket",
   "document_type": "ACME ZQX Ticket",
   "send_email_alert": 0,
   "states": [
    {
     "state": "ACME ZQX Taken",
     "allow_edit": "Sales User"
    },
    {
     "state": "ACME ZQX With the tailor",
     "allow_edit": "Sales User",
     "update_field": "ready_to_collect",
     "update_value": "0"
    },
    {
     "state": "ACME ZQX Fitting",
     "allow_edit": "Sales User",
     "update_field": "ready_to_collect",
     "update_value": "0"
    },
    {
     "state": "ACME ZQX Ready to collect",
     "allow_edit": "Sales User",
     "update_field": "ready_to_collect",
     "update_value": "1"
    },
    {
     "state": "ACME ZQX Handed over",
     "allow_edit": "System Manager",
     "update_field": "closed",
     "update_value": "1"
    },
    {
     "state": "ACME ZQX Cancelled",
     "allow_edit": "System Manager",
     "update_field": "closed",
     "update_value": "1"
    }
   ],
   "transitions": [
    {
     "state": "ACME ZQX Taken",
     "action": "ACME ZQX Send to tailor",
     "next_state": "ACME ZQX With the tailor",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "ACME ZQX With the tailor",
     "action": "ACME ZQX Book a fitting",
     "next_state": "ACME ZQX Fitting",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "ACME ZQX Fitting",
     "action": "ACME ZQX Back to tailor",
     "next_state": "ACME ZQX With the tailor",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "ACME ZQX With the tailor",
     "action": "ACME ZQX Ready",
     "next_state": "ACME ZQX Ready to collect",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "ACME ZQX Fitting",
     "action": "ACME ZQX Ready",
     "next_state": "ACME ZQX Ready to collect",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "ACME ZQX Ready to collect",
     "action": "ACME ZQX Back to tailor",
     "next_state": "ACME ZQX With the tailor",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "ACME ZQX Ready to collect",
     "action": "ACME ZQX Hand over",
     "next_state": "ACME ZQX Handed over",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "ACME ZQX Taken",
     "action": "ACME ZQX Cancel",
     "next_state": "ACME ZQX Cancelled",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "ACME ZQX With the tailor",
     "action": "ACME ZQX Cancel",
     "next_state": "ACME ZQX Cancelled",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "ACME ZQX Fitting",
     "action": "ACME ZQX Cancel",
     "next_state": "ACME ZQX Cancelled",
     "allowed": "Sales User",
     "allow_self_approval": 1
    },
    {
     "state": "ACME ZQX Ready to collect",
     "action": "ACME ZQX Cancel",
     "next_state": "ACME ZQX Cancelled",
     "allowed": "Sales User",
     "allow_self_approval": 1
    }
   ]
  }
 ],
 "print_formats": [
  {
   "name": "ACME ZQX Ticket",
   "doc_type": "ACME ZQX Ticket",
   "print_format_type": "Jinja",
   "html": "<div dir=\"auto\" style=\"font-family: Arial, sans-serif; font-size: 11pt;\">\n<h2 style=\"margin: 0 0 2px;\">{{ _(doc.kind) }} · {{ doc.name }}</h2>\n<p style=\"margin: 0 0 8px;\">{{ doc.customer_name or \"\" }} · {{ _(\"Collect at\") }} {{ doc.store_name or doc.store or \"\" }} · {{ _(\"Taken on\") }} {{ doc.get_formatted(\"taken_on\") }} · {{ _(\"Ready by\") }} {{ doc.get_formatted(\"due_date\") }}{% if doc.next_fitting %} · {{ _(\"Next fitting\") }} {{ doc.get_formatted(\"next_fitting\") }}{% endif %}</p>\n<table style=\"width: 100%; border-collapse: collapse;\" border=\"1\" cellpadding=\"4\">\n<tr><th style=\"text-align: start;\">{{ _(\"Garment\") }}</th><th style=\"text-align: start;\">{{ _(\"What to do\") }}</th></tr>\n{% for g in doc.garments %}<tr><td>{{ g.garment or g.item or \"\" }}</td><td>{{ g.work or \"\" }}</td></tr>\n{% endfor %}</table>\n{% if doc.measurements %}<p style=\"margin: 8px 0 0;\">{% for m in doc.measurements if m.measure %}{{ m.measure }} {{ m.get_formatted(\"value\") }} {{ m.unit }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}\n<p style=\"margin: 8px 0 0;\">{{ _(\"Please bring this slip when you collect.\") }}</p>\n<div style=\"border-top: 1px dashed #000; margin: 16px 0 8px;\"></div>\n<p style=\"margin: 0; font-size: 9pt;\">{{ _(\"Garment tag\") }}</p>\n<p style=\"margin: 0; font-size: 22pt; font-weight: bold;\">{{ doc.name }}</p>\n<p style=\"margin: 0;\">{{ doc.customer_name or \"\" }} · {{ _(\"Ready by\") }} {{ doc.get_formatted(\"due_date\") }}</p>\n<p style=\"margin: 0;\">{% for g in doc.garments %}{{ g.garment or g.item or \"\" }}{% if not loop.last %} · {% endif %}{% endfor %}</p>\n</div>"
  }
 ],
 "reports": [
  {
   "name": "ACME ZQX Tickets Due",
   "ref_doctype": "ACME ZQX Ticket",
   "report_type": "Report Builder",
   "columns": [
    "name",
    "customer_name",
    "kind",
    "store",
    "due_date",
    "next_fitting",
    "tailor",
    "ready_to_collect"
   ],
   "filters": [
    [
     "closed",
     "=",
     0
    ]
   ],
   "order_by": "due_date asc"
  }
 ],
 "links": [
  {
   "doctype": "Customer",
   "link_doctype": "ACME ZQX Ticket",
   "link_fieldname": "customer",
   "group": "Alterations"
  },
  {
   "doctype": "POS Invoice",
   "link_doctype": "ACME ZQX Ticket",
   "link_fieldname": "sale",
   "group": "Alterations"
  },
  {
   "doctype": "Sales Order",
   "link_doctype": "ACME ZQX Ticket",
   "link_fieldname": "order",
   "group": "Alterations"
  }
 ],
 "property_setters": [
  {
   "doc_type": "ACME ZQX Ticket",
   "property": "documentation",
   "property_type": "Data",
   "value": "https://developer.ivendnext.com/recipes/alteration_tickets.html#tickets"
  }
 ],
 "translations": [
  {
   "language": "en",
   "words": {
    "ACME ZQX Garment": "Garment",
    "ACME ZQX Measure": "Measurement",
    "ACME ZQX Ticket": "Alteration ticket",
    "ACME ZQX Taken": "Taken",
    "ACME ZQX With the tailor": "With the tailor",
    "ACME ZQX Fitting": "Fitting",
    "ACME ZQX Ready to collect": "Ready to collect",
    "ACME ZQX Handed over": "Handed over",
    "ACME ZQX Cancelled": "Cancelled",
    "ACME ZQX Send to tailor": "Send to tailor",
    "ACME ZQX Book a fitting": "Book a fitting",
    "ACME ZQX Back to tailor": "Back to tailor",
    "ACME ZQX Ready": "Ready",
    "ACME ZQX Hand over": "Hand over",
    "ACME ZQX Cancel": "Cancel",
    "ACME ZQX Tickets Due": "Tickets due"
   }
  }
 ]
}
